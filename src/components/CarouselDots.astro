---
// The dials for a QuoteCarousel.
//
// Split out of the carousel so a page can put them wherever the layout wants
// them — on the homepage they have to sit on the same line as the book's
// subtitle, which is nowhere near the quote they control. They are wired back
// to their carousel by name rather than by nesting.

interface Props {
  /** Must match the `name` given to the QuoteCarousel. */
  name: string;
  /** One dial per quote. */
  quotes: { source: string }[];
  class?: string;
}

const { name, quotes, class: className = '' } = Astro.props;
---

<ul class={`dots ${className}`.trim()} data-dots-for={name}>
  {
    quotes.map((q, i) => (
      <li>
        <button type="button" class="dot" data-dot aria-current={i === 0 ? 'true' : undefined}>
          <span class="vh">{`Endorsement ${i + 1} of ${quotes.length}`}</span>
        </button>
      </li>
    ))
  }
</ul>

<style>
  .dots {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Short pen strokes rather than bullets, to stay in the same hand as the
     drawn rules. The button keeps a comfortable target around a 1px mark. */
  .dot {
    display: block;
    width: 1.35rem;
    height: 1.5rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    position: relative;
  }

  .dot::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 1.35rem;
    height: 1px;
    background: var(--ink-25);
    transition:
      background-color var(--dur) var(--ease),
      height var(--dur) var(--ease);
  }

  .dot:hover::before {
    background: var(--ink-60);
  }

  .dot[aria-current]::before {
    background: var(--ink);
    height: 2px;
  }

  .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
