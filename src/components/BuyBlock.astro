---
// Where to buy.
//
// A quiet row of links, not a call to action. There was a stamped black "Buy"
// button here; Ben asked for it out — the eye went to the box rather than to
// the jacket, and it made the page read as a shop. Every seller is now set the
// same way, in the order the book's `buy` list gives them, so the publisher and
// Amazon carry equal weight and neither shouts.
//
// A row with no URL yet is set as plain text rather than a dead link.

interface Props {
  book: any;
  class?: string;
}

const { book, class: className = '' } = Astro.props;
const rows = (book.buy ?? []).filter((row) => row.url || row.todo);
---

<div class={`buy ${className}`.trim()}>
  <ul class="buy__list">
    {
      rows.map((row) => (
        <li>
          {row.url ? (
            <a class="buy__row" href={row.url} target="_blank" rel="noopener">
              <span class="buy__label ext">{row.label}</span>
              {row.note && <span class="buy__note">{row.note}</span>}
            </a>
          ) : (
            <span class="buy__row buy__row--pending" data-todo={row.todo}>
              <span class="buy__label">{row.label}</span>
              <span class="buy__note">link to follow</span>
            </span>
          )}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .buy {
    margin-top: var(--sp-lg);
    max-width: 22rem;
  }

  /* No rules in here: the client did not want the sellers fenced off from one
     another by hairlines. */
  .buy__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem clamp(1.25rem, 3vw, 2rem);
  }

  .buy__row {
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.15rem 0.6rem;
    padding-block: 0.35rem;
  }

  .buy__label {
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  /* These need their own underline to read as links, since there are no rules
     around them. */
  a.buy__row .buy__label {
    border-bottom: 1px solid var(--ink-25);
    padding-bottom: 1px;
    transition:
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  a.buy__row:hover .buy__label {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .buy__note {
    font-style: italic;
    font-size: 0.8125rem;
    color: var(--ink-60);
  }

  .buy__row--pending .buy__label {
    color: var(--ink-40);
  }
</style>
