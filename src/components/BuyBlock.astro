---
// Where to buy.
//
// One real button, which goes straight to Amazon, and the other sellers listed
// under it as hairline rows — the publisher first. If a title has no confirmed
// Amazon listing the button falls back to the publisher rather than being
// rendered dead, and the publisher is then not repeated in the list below.
//
// The button says "Buy" and nothing else, which is what the client asked for;
// the accessible name spells out the destination so a screen-reader user is
// not sent off-site by a one-word link.

interface Props {
  book: any;
  class?: string;
}

const { book, class: className = '' } = Astro.props;
const rows = book.buy ?? [];

const amazon = rows.find((row) => row.label === 'Amazon' && row.url);
const primary = amazon ?? rows.find((row) => row.url) ?? null;
const rest = rows.filter((row) => row !== primary);
---

<div class={`buy ${className}`.trim()}>
  {
    primary && (
      <a
        class="buy__button"
        href={primary.url}
        target="_blank"
        rel="noopener"
        aria-label={`Buy ${book.shortTitle} from ${primary.label}`}
      >
        Buy
      </a>
    )
  }

  {
    rest.length > 0 && (
      <ul class="buy__list">
        {rest.map((row) =>
          row.url ? (
            <li>
              <a class="buy__row" href={row.url} target="_blank" rel="noopener">
                <span class="buy__label ext">{row.label}</span>
                {row.note && <span class="buy__note">{row.note}</span>}
              </a>
            </li>
          ) : (
            <li>
              <span class="buy__row buy__row--pending" data-todo={row.todo}>
                <span class="buy__label">{row.label}</span>
                <span class="buy__note">link to follow</span>
              </span>
            </li>
          )
        )}
      </ul>
    )
  }
</div>

<style>
  .buy {
    margin-top: var(--sp-lg);
    max-width: 22rem;
  }

  /* Solid ink on paper — the one stamped element on the site, so it reads as
     the single thing to press without borrowing a colour from anywhere. */
  .buy__button {
    display: block;
    width: 100%;
    padding: 0.85rem 1.25rem;
    background: var(--ink);
    color: var(--paper);
    border: 1px solid var(--ink);
    font-size: 0.8125rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    text-align: center;
    transition:
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .buy__button:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--paper);
  }

  .buy__button:focus-visible {
    outline-offset: 4px;
  }

  .buy__list {
    list-style: none;
    margin: var(--sp-md) 0 0;
    padding: 0;
    border-top: 1px solid var(--ink-18);
  }

  .buy__list > li {
    border-bottom: 1px solid var(--ink-18);
  }

  /* In the narrow column beside a jacket there is not room for a label and its
     note side by side, so the note drops to its own line rather than breaking
     "German edition" across two. */
  .buy__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.15rem var(--sp-md);
    padding-block: 0.7rem;
  }

  .buy__label {
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .buy__note {
    margin-left: auto;
    font-style: italic;
    font-size: 0.8125rem;
    color: var(--ink-60);
    text-align: right;
  }

  .buy__row--pending .buy__label {
    color: var(--ink-40);
  }
</style>
