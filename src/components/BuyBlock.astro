---
// Where to buy.
//
// One real button, which goes straight to Amazon, and the other sellers listed
// under it as hairline rows — the publisher first. If a title has no confirmed
// Amazon listing the button falls back to the publisher rather than being
// rendered dead, and the publisher is then not repeated in the list below.
//
// The button says "Buy" and nothing else, which is what the client asked for;
// the accessible name spells out the destination so a screen-reader user is
// not sent off-site by a one-word link.

interface Props {
  book: any;
  class?: string;
}

const { book, class: className = '' } = Astro.props;
const rows = book.buy ?? [];

const amazon = rows.find((row) => row.label === 'Amazon' && row.url);
const primary = amazon ?? rows.find((row) => row.url) ?? null;
const rest = rows.filter((row) => row !== primary);

// The publisher sits beside the button; anything else — a translation, a
// listing still to be confirmed — goes underneath.
const beside = rest.find((row) => row.label === 'Publisher') ?? null;
const below = rest.filter((row) => row !== beside);
---

<div class={`buy ${className}`.trim()}>
  <div class="buy__primary">
    {
      primary && (
        <a
          class="buy__button"
          href={primary.url}
          target="_blank"
          rel="noopener"
          aria-label={`Buy ${book.shortTitle} from ${primary.label}`}
        >
          Buy
        </a>
      )
    }
    {
      beside &&
        (beside.url ? (
          <a class="buy__aside ext" href={beside.url} target="_blank" rel="noopener">
            {beside.label}
          </a>
        ) : (
          <span class="buy__aside buy__aside--pending" data-todo={beside.todo}>
            {beside.label}
          </span>
        ))
    }
  </div>

  {
    below.length > 0 && (
      <ul class="buy__list">
        {below.map((row) =>
          row.url ? (
            <li>
              <a class="buy__row" href={row.url} target="_blank" rel="noopener">
                <span class="buy__label ext">{row.label}</span>
                {row.note && <span class="buy__note">{row.note}</span>}
              </a>
            </li>
          ) : (
            <li>
              <span class="buy__row buy__row--pending" data-todo={row.todo}>
                <span class="buy__label">{row.label}</span>
                <span class="buy__note">link to follow</span>
              </span>
            </li>
          )
        )}
      </ul>
    )
  }
</div>

<style>
  .buy {
    margin-top: var(--sp-lg);
    max-width: 22rem;
  }

  /* Button and publisher on one line; in a column too narrow for both — the
     jacket column on the catalogue — the publisher wraps under it. */
  .buy__primary {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
  }

  /* Solid ink on paper — the one stamped element on the site, so it reads as
     the single thing to press without borrowing a colour from anywhere. */
  .buy__button {
    display: block;
    flex: 1 1 9rem;
    padding: 0.85rem 1.25rem;
    background: var(--ink);
    color: var(--paper);
    border: 1px solid var(--ink);
    font-size: 0.8125rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    text-align: center;
    transition:
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .buy__button:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--paper);
  }

  .buy__button:focus-visible {
    outline-offset: 4px;
  }

  .buy__aside {
    flex: none;
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
    border-bottom: 1px solid var(--ink-25);
    padding-bottom: 1px;
    transition:
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .buy__aside:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .buy__aside--pending {
    color: var(--ink-40);
    border-bottom-style: dotted;
  }

  /* No rules in here: the client did not want the remaining links fenced off
     from the button by hairlines. */
  .buy__list {
    list-style: none;
    margin: var(--sp-sm) 0 0;
    padding: 0;
  }

  /* In the narrow column beside a jacket there is not room for a label and its
     note side by side, so the note drops to its own line rather than breaking
     "German edition" across two. */
  .buy__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.15rem var(--sp-md);
    padding-block: 0.45rem;
  }

  .buy__label {
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  /* Without the hairline rows these need their own underline to read as
     links. */
  a.buy__row .buy__label {
    border-bottom: 1px solid var(--ink-25);
    padding-bottom: 1px;
    transition:
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  a.buy__row:hover .buy__label {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .buy__note {
    margin-left: auto;
    font-style: italic;
    font-size: 0.8125rem;
    color: var(--ink-60);
    text-align: right;
  }

  .buy__row--pending .buy__label {
    color: var(--ink-40);
  }
</style>
