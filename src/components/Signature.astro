---

{
  signature.src ? (
    <img
      class={`signature signature--scan ${className}`.trim()}
      src={u(signature.src)}
      alt="Ben Ware's signature"
      width={signature.width || undefined}
      height={signature.height || undefined}
      loading="lazy"
      {...rest}
    />
  ) : (
    <svg class={`signature ${className}`.trim()} viewBox="0 0 614 600" aria-hidden="true" {...rest}>
      <defs>
        <mask id="sig-reveal" maskUnits="userSpaceOnUse" x="0" y="0" width="614" height="600">
          {reveal.map((d) => <path class="ink sig__reveal" d={d} />)}
        </mask>
      </defs>
      <path class="sig__ink" d={ink} fill-rule="evenodd" mask="url(#sig-reveal)" />
    </svg>
  )
}

<style>
  .signature {
    display: block;
    /* Sized by HEIGHT: the real signature is nearly square, where the old
       stand-in was a wide monogram, so holding the width would have set it
       half as tall again as everything around it. */
    height: clamp(3.75rem, 6.5vw, 5.25rem);
    width: auto;
    margin-top: var(--sp-lg);
    overflow: visible;
  }

  /* Reached through the <svg>, not selected directly: Astro puts its scoping
     attribute on the root element of the component but not on these children,
     so a bare .sig__ink would compile to a selector that matches nothing.
     Going through the parent also outranks the global .ink rule, so none of
     this needs !important. */
  .signature :global(.sig__ink) {
    fill: var(--ink);
  }

  /* White is what a mask counts as "show". 34 units covers the widest part of
     the ink (30) with a little to spare; the round cap and join keep the
     revealing front from showing a square edge.
     The class .ink is kept on these so the draw-on engine finds them, but
     everything that rule sets for a visible pen mark has to come back off. */
  .signature :global(.sig__reveal) {
    fill: none;
    stroke: #fff;
    stroke-width: 34;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: none;
  }

  /* A scan arrives as pixels on white; multiply drops the paper away so it
     sits on the page rather than in a box. */
  .signature--scan {
    mix-blend-mode: multiply;
    height: auto;
    width: clamp(5.5rem, 9vw, 7.5rem);
  }
</style>
