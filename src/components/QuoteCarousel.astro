---
// A rotating endorsement.
//
// Every slide is stacked in the same grid cell, so the block reserves the
// height of the LONGEST quote once and nothing moves when it changes.
//
// The change itself is an ink bleed: the outgoing quote blurs and blooms into
// the paper, the incoming one condenses out of it. That is CSS blur combined
// with a hard contrast push — blur alone greys the letterforms, but blurring
// dark ink over white paper and then driving the contrast up throws the pale
// halo back to white and the dark core to black, which is what wet ink does on
// a soft sheet. It needs the slide to have an opaque paper background for the
// contrast to have something to bite on, which also means the incoming slide
// covers the outgoing one and the two quotes never show through each other.
//
// Accessibility: rotation stops on hover and on keyboard focus, and choosing a
// quote by hand stops it for good. There is also a real pause control, which is
// visually hidden until it is focused — the client asked for it not to show,
// and this keeps the mechanism WCAG 2.2.2 wants for a keyboard user without
// putting furniture on the page. With JavaScript off, or reduced motion asked
// for, the first quote simply stands.

interface Props {
  quotes: { quote: string; source: string }[];
  /** Milliseconds each quote is held. */
  interval?: number;
  label?: string;
  /** display = large italic, for the hero and the praise block. */
  tone?: 'display' | 'plain';
}

const { quotes, interval = 6000, label = 'Praise', tone = 'display' } = Astro.props;
---

<div
  class={`carousel carousel--${tone}`}
  data-carousel
  data-interval={interval}
  role="group"
  aria-roledescription="carousel"
  aria-label={label}
>
  <!-- The dials sit at the top right of the block, above the quote. -->
  <div class="carousel__head">
    <ul class="carousel__dots">
      {
        quotes.map((q, i) => (
          <li>
            <button
              type="button"
              class="carousel__dot"
              data-dot
              aria-current={i === 0 ? 'true' : undefined}
            >
              <span class="vh">{`Endorsement ${i + 1} of ${quotes.length}`}</span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="carousel__stage">
    {
      quotes.map((q, i) => (
        <figure
          class="carousel__slide"
          data-slide
          role="group"
          aria-roledescription="quotation"
          aria-label={`${i + 1} of ${quotes.length}`}
          aria-hidden={i === 0 ? undefined : 'true'}
          inert={i === 0 ? undefined : true}
        >
          <blockquote class="carousel__quote">{q.quote}</blockquote>
          <figcaption class="carousel__source" set:html={q.source} />
        </figure>
      ))
    }
  </div>

  <button type="button" class="carousel__pause" data-pause hidden>
    <span data-pause-label>Pause</span>
    <span class="vh"> the rotating endorsements</span>
  </button>
</div>

<style>
  .carousel {
    margin-top: var(--sp-md);
  }

  .carousel--display {
    max-width: 44ch;
  }

  .carousel__head {
    display: flex;
    justify-content: flex-end;
    margin-bottom: var(--sp-xs);
  }

  /* All slides share one cell, so the block is as tall as the longest and
     nothing below it moves when the quote changes. */
  .carousel__stage {
    display: grid;
    /* The bleed pushes ink past the letterforms; give it room to spread
       rather than clipping it at the block edge. */
    padding: 0.25rem 0;
  }

  /* The bleed. Two soft-edged washes at slightly different angles are used as
     a mask; sliding them across the quote makes an irregular, wet front that
     takes the ink off the page rather than fading it out evenly. A little blur
     rides along with it so the letterforms soften as they go, the way ink does
     when it spreads into a sheet.
     Filtering the glyphs themselves was tried first and does not work: an
     alpha threshold turns fine Caslon strokes to nothing rather than blooming
     them, and a contrast push throws them white. Moving a soft edge across the
     text is what actually reads as ink.
     Opacity carries the same transition, so if masks are unavailable this
     degrades to a soft dissolve rather than to nothing. */
  .carousel__slide {
    --wash: linear-gradient(97deg, #000 0 26%, rgba(0, 0, 0, 0.6) 42%, rgba(0, 0, 0, 0) 56%),
      linear-gradient(83deg, #000 0 30%, rgba(0, 0, 0, 0.5) 46%, rgba(0, 0, 0, 0) 62%);

    grid-area: 1 / 1;
    margin: 0;
    opacity: 0;
    filter: blur(2px);

    -webkit-mask-image: var(--wash);
    mask-image: var(--wash);
    -webkit-mask-size: 260% 100%;
    mask-size: 260% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    /* Washed off the page. */
    -webkit-mask-position: 100% 0;
    mask-position: 100% 0;

    transition:
      opacity 0.55s var(--ease),
      filter 0.55s var(--ease),
      -webkit-mask-position 0.55s var(--ease),
      mask-position 0.55s var(--ease);
  }

  .carousel__slide:first-child {
    opacity: 1;
    filter: none;
    -webkit-mask-position: 0 0;
    mask-position: 0 0;
  }

  /* Once the script has taken over, :first-child stops being special. */
  [data-carousel][data-ready] .carousel__slide {
    opacity: 0;
    filter: blur(2px);
    -webkit-mask-position: 100% 0;
    mask-position: 100% 0;
  }

  [data-carousel][data-ready] .carousel__slide[data-active] {
    opacity: 1;
    filter: blur(0);
    -webkit-mask-position: 0 0;
    mask-position: 0 0;
    z-index: 2;
    /* The outgoing quote washes off before the incoming one washes in, so two
       different quotes are never legible over each other. */
    transition-delay: 0.45s;
  }

  .carousel--display .carousel__quote {
    font-family: var(--display);
    font-size: clamp(1.1rem, 1.6vw, 1.35rem);
    font-style: italic;
    line-height: 1.45;
  }

  .carousel__quote {
    margin: 0;
    color: var(--ink);
  }

  .carousel__quote::before {
    content: '\201C';
  }

  .carousel__quote::after {
    content: '\201D';
  }

  .carousel__source {
    margin-top: 0.6rem;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-60);
  }

  .carousel__source::before {
    content: '\2014\00a0';
  }

  .carousel__source :global(em) {
    font-style: italic;
    text-transform: none;
    letter-spacing: 0.06em;
  }

  .carousel__dots {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Short pen strokes rather than bullets, to stay in the same hand as the
     drawn rules. The button keeps a comfortable target around a 1px mark. */
  .carousel__dot {
    display: block;
    width: 1.35rem;
    height: 1.5rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    position: relative;
  }

  .carousel__dot::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 1.35rem;
    height: 1px;
    background: var(--ink-25);
    transition:
      background-color var(--dur) var(--ease),
      height var(--dur) var(--ease);
  }

  .carousel__dot:hover::before {
    background: var(--ink-60);
  }

  .carousel__dot[aria-current]::before {
    background: var(--ink);
    height: 2px;
  }

  /* Present for a keyboard, absent for the eye — the same bargain a skip link
     makes. */
  .carousel__pause {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
    background: none;
    cursor: pointer;
    font-family: var(--text);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-60);
  }

  .carousel__pause:focus-visible {
    position: static;
    width: auto;
    height: auto;
    margin: var(--sp-sm) 0 0;
    overflow: visible;
    clip-path: none;
  }

  .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* A bleed is motion. Asked to hold still, the quotes just cut — the mask and
     the blur come off entirely so nothing is left half-washed. */
  @media (prefers-reduced-motion: reduce) {
    .carousel__slide,
    [data-carousel][data-ready] .carousel__slide,
    [data-carousel][data-ready] .carousel__slide[data-active] {
      filter: none;
      -webkit-mask-image: none;
      mask-image: none;
      transition-delay: 0s;
    }
  }
</style>

<script>
  document.querySelectorAll('[data-carousel]').forEach((root) => {
    const slides = Array.from(root.querySelectorAll('[data-slide]'));
    const dots = Array.from(root.querySelectorAll('[data-dot]'));
    const pauseBtn = root.querySelector('[data-pause]');
    const pauseLabel = root.querySelector('[data-pause-label]');
    if (slides.length < 2) return;

    const interval = Number(root.dataset.interval) || 6000;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let index = 0;
    let timer = null;
    // Auto-rotation off means the reader turned it off; suspension is a
    // temporary halt while they hover or tab through.
    let auto = !reduceMotion;
    let suspended = false;

    root.setAttribute('data-ready', '');
    // Nothing is rotating under reduced motion, so there is nothing to pause.
    pauseBtn.hidden = reduceMotion;

    function show(next) {
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const active = i === index;
        slide.toggleAttribute('data-active', active);
        // Hidden slides leave the reading order entirely, so a screen reader
        // or a Tab press never lands on an invisible quote.
        slide.setAttribute('aria-hidden', active ? 'false' : 'true');
        slide.inert = !active;
      });
      dots.forEach((dot, i) => {
        if (i === index) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    }

    function tick() {
      if (!auto || suspended || document.hidden) return;
      show(index + 1);
    }

    function start() {
      stop();
      if (!auto) return;
      timer = window.setInterval(tick, interval);
    }

    function stop() {
      if (timer !== null) window.clearInterval(timer);
      timer = null;
    }

    function setAuto(on) {
      auto = on;
      pauseLabel.textContent = on ? 'Pause' : 'Play';
      if (on) start();
      else stop();
    }

    // Hover and focus suspend rather than cancel: reading a quote should not
    // permanently change the page's behaviour.
    root.addEventListener('mouseenter', () => (suspended = true));
    root.addEventListener('mouseleave', () => (suspended = false));
    root.addEventListener('focusin', () => (suspended = true));
    root.addEventListener('focusout', () => (suspended = false));

    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        show(i);
        setAuto(false); // taking control keeps it
      })
    );

    pauseBtn.addEventListener('click', () => setAuto(!auto));

    // A background tab starves timers; restart cleanly on return rather than
    // firing a backlog of transitions at once.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    show(0);
    start();
  });
</script>
