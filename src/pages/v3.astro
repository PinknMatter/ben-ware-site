---
// VERSION 3 — "The Frontispiece"
//
// Concept: the homepage as the opening leaf of a book. In classical book
// design the frontispiece — an engraved portrait — faces the title page, so
// the reader meets the author and the title in one spread. That is the hero:
// Ben's portrait mounted as a plate on the left, the title block on the
// right. Below it the page turns scholarly: a narrow margin column carrying
// small-caps section heads, a wide measure carrying the works. Everything is
// informative, ranged and quiet.
//
// The flair is one pen, used three times and never more: the signature under
// the title block, a single drawn underline in the lede, and the wavy flourish
// rules between sections. All are inline SVG drawn on with GSAP DrawSVG.
//
// Type is Libre Caslon — Caslon being the English book face, and a clean
// break from V1's Space Mono and V2's Courier Prime. No monospace anywhere.
// Paper is white; the accent red stays hover-only, as everywhere else.
//
// NOTE: the signature is a drawn placeholder in Ben's hand-style, not his
// actual autograph — see data-todo="signature-scan".
import Base from '../layouts/Base.astro';
import { books } from '../data/books.js';
import { writing, interviews, videos } from '../data/writing.js';

// Works, newest first — the standard order for a list of books.
const works = [...books].sort((a, b) => Number(b.year) - Number(a.year));

// On Extinction leads the shelf: the single-authored trade book, and the one
// the lede already points at. The rest follow as a run of covers.
const lead = works.find((b) => b.slug === 'on-extinction') ?? works[0];
const shelf = works.filter((b) => b !== lead);

// Five pieces that have both a venue and a live link.
const selectedWriting = writing.filter((w) => w.url && w.venue).slice(0, 5);

// Talk titles carry venue and year in a trailing parenthetical; split them out
// so the rows read like the rest of the lists, year hanging in the margin.
function splitVenue(title) {
  const m = title.match(/^(.*?)\s*\(([^()]*)\)\s*$/);
  if (!m) return { title, meta: null, year: null };
  const withYear = m[2].match(/^(.*?),\s*(\d{4})$/);
  return withYear
    ? { title: m[1], meta: withYear[1], year: withYear[2] }
    : { title: m[1], meta: m[2], year: null };
}

// The interviews carry no date in the source data; "n.d." is the convention
// writing.js already uses for those, and correct in a list like this.
const media = [
  ...interviews.map((i) => ({ title: i.title, meta: i.venue, year: null, url: i.url })),
  ...videos.slice(0, 3).map((v) => ({ ...splitVenue(v.title), url: v.url })),
];

const year = new Date().getFullYear();
import { u } from '../lib/url.js';
---

<Base title="Ben Ware — Philosopher and social theorist">
  <!-- The whole leaf sits on white, nav and colophon included. -->
  <style is:global>
    html body {
      background: #ffffff;
    }
  </style>

  <div class="v3">
    <!-- Running head: the classical page header — name left, contents right,
         hairline under. -->
    <header class="v3-head">
      <div class="v3-measure v3-head__inner">
        <a class="v3-head__name" href={u('/v3')}>Ben Ware</a>
        <nav class="v3-head__nav" aria-label="Main">
          <a href={u('/books')}>Books</a>
          <a href={u('/writing')}>Writing &amp; Media</a>
          <a href={u('/biog')}>Biog</a>
        </nav>
      </div>
      <hr class="v3-hair" />
    </header>

    <main class="v3-measure">
      <!-- ----------------------------------------------------------------
           Frontispiece: the plate faces the title block. Ben looks toward
           frame right, so the portrait takes the left and his eyeline runs
           into the type.
      ----------------------------------------------------------------- -->
      <section class="v3-frontis" aria-label="Ben Ware">
        <figure class="v3-plate">
          <span class="v3-plate__mount">
            <img
              class="v3-plate__img"
              src={u('/images/ben-ware-portrait.jpg')}
              alt="Ben Ware"
              width="759"
              height="986"
              loading="eager"
            />
          </span>
          <!-- A plate caption credits the engraver; here it wants the
               photographer, once the client supplies the name. -->
          <figcaption class="v3-plate__caption" data-todo="portrait-credit">London</figcaption>
        </figure>

        <div class="v3-title">
          <h1 class="v3-title__name">Ben Ware</h1>

          <svg
            class="v3-flourish v3-flourish--title"
            viewBox="0 0 300 18"
            aria-hidden="true"
          >
            <path
              class="v3-ink"
              d="M4,11 C40,5 78,14 116,8 C152,3 190,13 228,8 C254,4 276,11 296,6"
            />
          </svg>

          <p class="v3-title__role">Philosopher and social theorist</p>

          <p class="v3-title__lede">
            Philosophy that begins at the end — taking
            <a class="v3-marked" href={u('/books#on-extinction')}>
              extinction
              <svg
                class="v3-marked__rule"
                viewBox="0 0 100 10"
                aria-hidden="true"
              >
                <path class="v3-ink" d="M2,5 C24,2 52,8 76,4 C86,2 94,6 98,4" />
              </svg>
            </a>
            as the lens through which to read the present. Co-Director of the Centre
            for Philosophy and Art at King's College London.
          </p>

          <!-- Initialled BW, the way a signature is abbreviated: the looped B,
               the W, then the paraph thrown back underneath. Three strokes in
               the order a hand makes them; the slant is carried by the skew
               rather than baked into every coordinate. Still a drawn stand-in
               until the client sends a scan of Ben's own. -->
          <svg
            class="v3-signature"
            viewBox="0 0 180 110"
            aria-hidden="true"
            data-todo="signature-scan"
          >
            <g transform="skewX(-12) translate(20 0)">
              <path
                class="v3-ink v3-ink--pen"
                d="M10,84 C18,60 28,38 38,18 C41,10 51,10 54,18 C58,29 46,38 33,40
                   C48,39 63,44 61,55 C59,66 44,70 31,63"
              />
              <path
                class="v3-ink v3-ink--pen"
                d="M66,22 C71,44 79,63 87,76 C94,62 99,43 103,22
                   C107,44 114,63 121,76 C128,61 134,41 138,20"
              />
              <path
                class="v3-ink v3-ink--pen"
                d="M14,95 C52,88 102,99 148,90 C157,88 161,93 153,97"
              />
            </g>
          </svg>
        </div>
      </section>

      <svg class="v3-flourish v3-flourish--break" viewBox="0 0 600 12" aria-hidden="true" data-draw>
        <path class="v3-ink" d="M4,6 C96,2 188,10 280,5 C372,1 464,9 556,4 C570,3 584,6 596,5" />
      </svg>

      <!-- ----------------------------------------------------------------
           Books, given the widest column on the page: the lead title set as
           a proper book announcement — cover, hook, imprint — and the rest
           as a run of covers on a shelf. Nothing ruled, so this section
           reads as pictures where the two below read as bibliography.
      ----------------------------------------------------------------- -->
      <section class="v3-block v3-block--wide" id="books" aria-labelledby="v3-books">
        <h2 class="v3-label" id="v3-books">Books</h2>
        <div class="v3-block__body">
          <article class="v3-lead">
            <a class="v3-lead__cover" href={u(`/books#${lead.slug}`)} tabindex="-1" aria-hidden="true">
              <img
                src={u(lead.cover)}
                alt=""
                width="400"
                height="600"
                loading="lazy"
                data-todo={lead.coverIsPlaceholder ? 'cover-living-wrong-life' : undefined}
              />
            </a>
            <div class="v3-lead__text">
              <p class="v3-lead__imprint">
                {lead.publisher}, {lead.year}
              </p>
              <h3 class="v3-lead__title">
                <a href={u(`/books#${lead.slug}`)}>{lead.title}</a>
              </h3>
              <p class="v3-lead__hook">{lead.hook}</p>
              <p class="v3-more">
                <a class="v3-link" href={u(`/books#${lead.slug}`)}>Read more</a>
              </p>
            </div>
          </article>

          <ul class="v3-shelf">
            {
              shelf.map((book) => (
                <li>
                  <a class="v3-shelf__item" href={u(`/books#${book.slug}`)}>
                    <span class="v3-shelf__cover">
                      <img
                        src={u(book.cover)}
                        alt={`Cover of ${book.shortTitle}`}
                        width="400"
                        height="600"
                        loading="lazy"
                        data-todo={book.coverIsPlaceholder ? 'cover-living-wrong-life' : undefined}
                      />
                    </span>
                    <span class="v3-shelf__title">{book.shortTitle}</span>
                    <span class="v3-shelf__meta">
                      {book.publisher}, {book.year}{book.role ? ` — as ${book.role}` : ''}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>

          <p class="v3-more">
            <a class="v3-link" href={u('/books')}>All books</a>
          </p>
        </div>
      </section>

      <svg class="v3-flourish v3-flourish--break" viewBox="0 0 600 12" aria-hidden="true" data-draw>
        <path class="v3-ink" d="M4,5 C92,9 184,2 276,7 C368,11 460,3 552,7 C568,8 584,5 596,6" />
      </svg>

      <!-- Selected writing: the same entry, venue in place of publisher. -->
      <section class="v3-block" id="writing" aria-labelledby="v3-writing">
        <h2 class="v3-label" id="v3-writing">Writing</h2>
        <div class="v3-block__body">
          <ol class="v3-entries">
            {
              selectedWriting.map((item) => (
                <li>
                  <a class="v3-entry" href={u(item.url)} target="_blank" rel="noopener">
                    <span class="v3-entry__year">{item.year}</span>
                    <span class="v3-entry__text">
                      <span class="v3-entry__title">{item.title}</span>
                      <span class="v3-entry__meta">{item.venue}</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ol>
          <p class="v3-more">
            <a class="v3-link" href={u('/writing')}>All writing</a>
          </p>
        </div>
      </section>

      <svg class="v3-flourish v3-flourish--break" viewBox="0 0 600 12" aria-hidden="true" data-draw>
        <path class="v3-ink" d="M4,7 C88,3 180,9 272,5 C364,1 456,8 548,5 C566,4 582,7 596,6" />
      </svg>

      <!-- Interviews and recorded talks, in one list. -->
      <section class="v3-block" id="media" aria-labelledby="v3-media">
        <h2 class="v3-label" id="v3-media">Media</h2>
        <div class="v3-block__body">
          <ul class="v3-entries">
            {
              media.map((item) => (
                <li>
                  <a class="v3-entry" href={u(item.url)} target="_blank" rel="noopener">
                    {
                      item.year ? (
                        <span class="v3-entry__year">{item.year}</span>
                      ) : (
                        <span class="v3-entry__year v3-entry__year--nd" data-todo="interview-dates">
                          n.d.
                        </span>
                      )
                    }
                    <span class="v3-entry__text">
                      <span class="v3-entry__title">{item.title}</span>
                      {item.meta && <span class="v3-entry__meta">{item.meta}</span>}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="v3-more">
            <a class="v3-link" href={u('/writing')}>All interviews &amp; talks</a>
          </p>
        </div>
      </section>

      <!-- The ask, closing the leaf. -->
      <section class="v3-block v3-enquiries" aria-labelledby="v3-enquiries">
        <h2 class="v3-label" id="v3-enquiries">Enquiries</h2>
        <div class="v3-block__body">
          <p class="v3-enquiries__text">
            For speaking, press and rights, Ben is represented by
            <a
              class="v3-link"
              href="https://cwagency.co.uk"
              target="_blank"
              rel="noopener"
              data-todo="verify-cw-url"><span class="v3-nowrap">C&amp;W Agency</span></a>.
          </p>
          <p class="v3-enquiries__note" data-todo="enquiries-email">
            A direct address will follow.
          </p>
        </div>
      </section>
    </main>

    <!-- Colophon: the foot of the leaf, on the same margin seam. -->
    <footer class="v3-colophon">
      <div class="v3-measure">
        <hr class="v3-hair" />
        <div class="v3-colophon__grid">
          <div class="v3-colophon__imprint">
            <span>© {year} Ben Ware</span>
            <span>London, UK</span>
          </div>

          <div class="v3-colophon__cols">
            <nav class="v3-colophon__col" aria-labelledby="v3-foot-site">
              <h2 class="v3-label" id="v3-foot-site">Site</h2>
              <ul>
                <li><a class="v3-link" href={u('/books')}>Books</a></li>
                <li><a class="v3-link" href={u('/writing')}>Writing &amp; Media</a></li>
                <li><a class="v3-link" href={u('/biog')}>Biog</a></li>
              </ul>
            </nav>

            <nav class="v3-colophon__col" aria-labelledby="v3-foot-elsewhere">
              <h2 class="v3-label" id="v3-foot-elsewhere">Elsewhere</h2>
              <ul>
                <li>
                  <a
                    class="v3-link"
                    href="https://www.kcl.ac.uk/research/centre-for-philosophy-and-visual-arts"
                    target="_blank"
                    rel="noopener">Centre for Philosophy &amp; Art</a>
                </li>
                <li>
                  <a
                    class="v3-link"
                    href="https://www.bicar.org"
                    target="_blank"
                    rel="noopener"
                    data-todo="verify-bicar-url">BICAR</a>
                </li>
              </ul>
            </nav>
          </div>
        </div>
      </div>
    </footer>
  </div>

  <style>
    /* ------------------------------------------------------------------
       Tokens. White paper, with the barest warmth left in the ink so the
       type reads as printed rather than as pure black on pure white.
    ------------------------------------------------------------------ */

    .v3 {
      --paper: #ffffff;
      --ink: oklch(23% 0.006 60);
      --ink-60: color-mix(in oklab, var(--ink) 60%, var(--paper));
      --ink-40: color-mix(in oklab, var(--ink) 40%, var(--paper));
      --ink-18: color-mix(in oklab, var(--ink) 18%, var(--paper));

      --display: 'Libre Caslon Display', 'Libre Caslon Text', Georgia, serif;
      --text: 'Libre Caslon Text', Georgia, serif;

      /* Margin column for the small-caps heads, as in a scholarly edition —
         set out from the measure, but still reading as its label. */
      --margin-col: clamp(4.5rem, 9vw, 7.5rem);
      --margin-gap: clamp(1.25rem, 2.5vw, 2rem);

      --sp-xs: 0.5rem;
      --sp-sm: 0.75rem;
      --sp-md: 1.5rem;
      --sp-lg: 2.5rem;
      --sp-xl: clamp(3rem, 7vh, 5rem);
      --sp-2xl: clamp(4.5rem, 11vh, 8rem);

      background: var(--paper);
      color: var(--ink);
      font-family: var(--text);
      font-size: 1.0625rem;
      line-height: 1.65;
    }

    .v3-measure {
      max-width: 62rem;
      margin-inline: auto;
      padding-inline: clamp(1.25rem, 5vw, 4rem);
    }

    .v3 :where(h1, h2) {
      font-family: var(--display);
      font-weight: 400;
      line-height: 1.05;
      margin: 0;
    }

    /* Small caps set the way a book sets them: real caps, tracked out,
       never a heavier weight. */
    .v3-label {
      font-family: var(--text);
      font-size: 0.75rem;
      font-weight: 400;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--ink-60);
      margin: 0;
    }

    .v3-hair {
      border: 0;
      border-top: 1px solid var(--ink-18);
      margin: 0;
    }

    /* ------------------------------------------------------------------
       Running head
    ------------------------------------------------------------------ */

    .v3-head__inner {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--sp-md);
      flex-wrap: wrap;
      padding-block: var(--sp-md);
    }

    .v3-head__name,
    .v3-head__nav a {
      font-size: 0.75rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
    }

    .v3-head__nav {
      display: flex;
      gap: clamp(1rem, 3vw, 2.25rem);
    }

    .v3-head__name:hover,
    .v3-head__nav a:hover {
      color: var(--color-accent);
    }

    /* ------------------------------------------------------------------
       Frontispiece: plate | title block
    ------------------------------------------------------------------ */

    .v3-frontis {
      display: grid;
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: clamp(2rem, 5vw, 5rem);
      align-items: start;
      padding-block: var(--sp-xl) var(--sp-lg);
    }

    /* The portrait is mounted, not cropped into a card: a hairline keyline
       with a breath of paper inside it, the way a plate is tipped in. */
    .v3-plate {
      margin: 0;
    }

    .v3-plate__mount {
      display: block;
      border: 1px solid var(--ink-18);
      padding: clamp(0.5rem, 1.2vw, 0.9rem);
    }

    .v3-plate__img {
      width: 100%;
      height: auto;
      aspect-ratio: 759 / 986;
      object-fit: cover;
      /* The photograph is already monochrome, so on white it needs nothing
         but a hair of contrast — the warmth it wanted on ivory would read
         as a yellow cast here. */
      filter: contrast(1.03);
    }

    .v3-plate__caption {
      margin-top: var(--sp-sm);
      font-style: italic;
      font-size: 0.9375rem;
      color: var(--ink-60);
    }

    .v3-title__name {
      font-size: clamp(3rem, 7vw, 5.5rem);
      letter-spacing: -0.015em;
    }

    .v3-title__role {
      margin: var(--sp-md) 0 0;
      font-style: italic;
      font-size: clamp(1.1rem, 1.5vw, 1.35rem);
      color: var(--ink-60);
    }

    .v3-title__lede {
      margin: var(--sp-lg) 0 0;
      max-width: 42ch;
      font-size: clamp(1.1rem, 1.5vw, 1.3rem);
      line-height: 1.6;
    }

    /* ------------------------------------------------------------------
       The pen: one stroke weight, four uses.
    ------------------------------------------------------------------ */

    .v3-ink {
      fill: none;
      stroke: var(--ink);
      stroke-width: 1.4;
      stroke-linecap: round;
      stroke-linejoin: round;
      vector-effect: non-scaling-stroke;
    }

    .v3-ink--pen {
      stroke-width: 2.1;
    }

    .v3-flourish--title {
      margin-top: var(--sp-sm);
      max-width: 18rem;
    }

    .v3-flourish--break {
      margin-block: var(--sp-xl);
      opacity: 0.75;
    }

    /* Marks scale uniformly. A stretched viewBox (preserveAspectRatio="none")
       distorts the dash pattern DrawSVG animates, which breaks the stroke into
       gaps — so every mark keeps its aspect and scales as one. */
    .v3-flourish {
      display: block;
      width: 100%;
      height: auto;
      overflow: visible;
    }

    /* A phrase with a drawn rule under it — the one mark inside the text. */
    .v3-marked {
      position: relative;
      display: inline-block;
      white-space: nowrap;
    }

    .v3-marked:hover {
      color: var(--color-accent);
    }

    .v3-marked:hover .v3-ink {
      stroke: var(--color-accent);
    }

    .v3-marked__rule {
      position: absolute;
      left: -0.15em;
      bottom: -0.3em;
      width: calc(100% + 0.3em);
      height: auto;
      overflow: visible;
      pointer-events: none;
    }

    .v3-signature {
      display: block;
      width: clamp(5.5rem, 9vw, 7.5rem);
      height: auto;
      margin-top: var(--sp-lg);
      transform: rotate(-1.5deg);
      transform-origin: left center;
    }

    /* ------------------------------------------------------------------
       Blocks: small-caps head in the margin, the list in the measure.
    ------------------------------------------------------------------ */

    .v3-block {
      display: flex;
      flex-direction: column;
      gap: var(--sp-md);
    }

    .v3-block__body {
      max-width: none;
    }



    .v3-entries {
      list-style: none;
      margin: 0;
      padding: 0;
      border-top: 1px solid var(--ink-18);
    }

    .v3-entries li {
      border-bottom: 1px solid var(--ink-18);
    }

    .v3-entry {
      display: grid;
      grid-template-columns: 4.5rem minmax(0, 1fr);
      gap: var(--sp-md);
      align-items: baseline;
      padding-block: var(--sp-md);
    }

    .v3-entry__year {
      font-size: 0.8125rem;
      letter-spacing: 0.12em;
      color: var(--ink-40);
      font-variant-numeric: tabular-nums;
    }

    .v3-entry__year--nd {
      font-style: italic;
      letter-spacing: 0.04em;
    }

    .v3-entry__title {
      display: block;
      font-family: var(--display);
      font-size: clamp(1.2rem, 1.9vw, 1.55rem);
      line-height: 1.25;
      transition: color 0.3s var(--ease-standard);
    }

    .v3-entry:hover .v3-entry__title {
      color: var(--color-accent);
    }

    .v3-entry__meta {
      display: block;
      margin-top: 0.35rem;
      font-style: italic;
      font-size: 0.9375rem;
      color: var(--ink-60);
    }

    .v3-more {
      margin: var(--sp-md) 0 0;
    }

    .v3-more .v3-link,
    .v3-colophon__col .v3-link {
      font-size: 0.9375rem;
    }

    .v3-link {
      border-bottom: 1px solid var(--ink-18);
      padding-bottom: 1px;
      transition:
        color 0.3s var(--ease-standard),
        border-color 0.3s var(--ease-standard);
    }

    .v3-link:hover {
      color: var(--color-accent);
      border-bottom-color: var(--color-accent);
    }

    /* ------------------------------------------------------------------
       Books: the lead title announced, then the shelf. No rules here — the
       covers carry the section, which is what stops the lower page reading
       as three identical lists.
    ------------------------------------------------------------------ */

    .v3-lead {
      display: grid;
      grid-template-columns: clamp(9rem, 16vw, 14rem) minmax(0, 1fr);
      gap: clamp(1.5rem, 4vw, 3rem);
      align-items: start;
    }

    .v3-lead__cover img,
    .v3-shelf__cover img {
      width: 100%;
      height: auto;
      aspect-ratio: 2 / 3;
      object-fit: cover;
      background: color-mix(in oklab, var(--ink) 8%, var(--paper));
    }

    .v3-lead__text {
      max-width: 44ch;
    }

    .v3-lead__imprint {
      margin: 0;
      font-size: 0.75rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--ink-60);
    }

    .v3-lead__title {
      margin: 0.6rem 0 0;
      font-family: var(--display);
      font-weight: 400;
      font-size: clamp(1.5rem, 2.6vw, 2.15rem);
      line-height: 1.15;
    }

    .v3-lead__title a {
      transition: color 0.3s var(--ease-standard);
    }

    .v3-lead__title a:hover {
      color: var(--color-accent);
    }

    .v3-lead__hook {
      margin: var(--sp-md) 0 0;
      font-size: 1.0625rem;
      line-height: 1.7;
    }

    /* The shelf: covers at a reading size, captioned beneath. auto-fit means
       it reflows without a breakpoint. */
    .v3-shelf {
      list-style: none;
      margin: var(--sp-xl) 0 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 8.5rem), 1fr));
      gap: clamp(1.25rem, 2.5vw, 2.25rem);
    }

    .v3-shelf__cover {
      display: block;
    }

    .v3-shelf__title {
      display: block;
      margin-top: 0.65rem;
      font-family: var(--display);
      font-size: 1rem;
      line-height: 1.3;
      transition: color 0.3s var(--ease-standard);
    }

    .v3-shelf__item:hover .v3-shelf__title {
      color: var(--color-accent);
    }

    .v3-shelf__meta {
      display: block;
      margin-top: 0.2rem;
      font-style: italic;
      font-size: 0.875rem;
      color: var(--ink-60);
    }

    @media (prefers-reduced-motion: reduce) {
      .v3-lead__title a,
      .v3-shelf__title {
        transition: none;
      }
    }

    /* ------------------------------------------------------------------
       Enquiries + colophon
    ------------------------------------------------------------------ */

    .v3-enquiries {
      padding-top: var(--sp-2xl);
    }

    .v3-enquiries__text {
      margin: 0;
      max-width: 46ch;
      font-size: clamp(1.1rem, 1.5vw, 1.3rem);
      line-height: 1.6;
    }

    .v3-nowrap {
      white-space: nowrap;
    }

    .v3-enquiries__note {
      margin: var(--sp-md) 0 0;
      font-style: italic;
      font-size: 0.9375rem;
      color: var(--ink-60);
    }

    .v3-colophon {
      margin-top: var(--sp-2xl);
      padding-bottom: var(--sp-xl);
    }

    .v3-colophon__grid {
      display: flex;
      flex-direction: column;
      gap: var(--sp-lg);
      padding-top: var(--sp-lg);
    }

    .v3-colophon__imprint {
      order: 2;
      display: flex;
      gap: var(--sp-md);
      flex-wrap: wrap;
      font-size: 0.8125rem;
      letter-spacing: 0.02em;
      white-space: nowrap;
      color: var(--ink-60);
    }

    .v3-colophon__cols {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
      gap: var(--sp-lg);
      max-width: 44rem;
    }

    .v3-colophon__col ul {
      list-style: none;
      margin: var(--sp-sm) 0 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      align-items: flex-start;
    }

    /* The colophon heads are not sitting against large text. */
    .v3-colophon__col .v3-label {
      padding-top: 0;
    }

    @media (prefers-reduced-motion: reduce) {
      .v3-entry__title,
      .v3-link {
        transition: none;
      }
    }

    /* ------------------------------------------------------------------
       Narrow leaf: the plate leads, the margin column folds into the flow.
    ------------------------------------------------------------------ */

    @media (max-width: 820px) {
      .v3-frontis {
        grid-template-columns: minmax(0, 1fr);
        gap: var(--sp-lg);
      }

      .v3-plate {
        width: min(100%, 20rem);
      }


      .v3-lead {
        grid-template-columns: minmax(0, 1fr);
      }

      .v3-lead__cover {
        display: block;
        width: min(100%, 12rem);
      }

    }

    @media (max-width: 520px) {
      .v3-entry {
        grid-template-columns: minmax(0, 1fr);
        gap: 0.35rem;
      }
    }
  </style>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import { DrawSVGPlugin } from 'gsap/DrawSVGPlugin';

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Reduced motion: every mark is already drawn — this is its rest state.
    if (!reduceMotion) {
      gsap.registerPlugin(ScrollTrigger, DrawSVGPlugin);

      const load = ['.v3-flourish--title .v3-ink', '.v3-signature .v3-ink', '.v3-marked__rule .v3-ink'];
      gsap.set(load, { drawSVG: '0%' });

      // The title's flourish, then the mark in the lede, then the hand
      // signing — the order a person would actually make them.
      const intro = gsap
        .timeline({ defaults: { ease: 'power2.inOut' } })
        .to('.v3-flourish--title .v3-ink', { drawSVG: '100%', duration: 0.7 }, 0.35)
        .to('.v3-marked__rule .v3-ink', { drawSVG: '100%', duration: 0.45 }, 0.8)
        .to(
          '.v3-signature .v3-ink',
          { drawSVG: '100%', duration: 0.75, stagger: 0.25, ease: 'power1.inOut' },
          1.05
        );

      // The section breaks draw as the leaf is read.
      const breaks = [];
      document.querySelectorAll('[data-draw]').forEach((mark) => {
        const strokes = mark.querySelectorAll('.v3-ink');
        gsap.set(strokes, { drawSVG: '0%' });
        breaks.push(
          gsap.to(strokes, {
            drawSVG: '100%',
            duration: 0.8,
            stagger: 0.1,
            ease: 'power2.inOut',
            scrollTrigger: { trigger: mark, start: 'top 92%' },
          })
        );
      });

      // Every mark starts at zero length, so a ticker that never advances would
      // leave the signature invisible and the rules broken mid-dash — a page
      // opened in a background tab, or any environment that starves the
      // animation clock. Check the intro's own progress on a timer, which runs
      // independently of the frame loop: if it hasn't finished long after it
      // should have, put every mark straight to drawn.
      window.setTimeout(() => {
        if (intro.progress() === 1) return;
        intro.progress(1);
        breaks.forEach((tween) => tween.progress(1));
      }, 3000);
    }
  </script>
</Base>
