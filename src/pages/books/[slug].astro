---
// A book's own page: the title page, then the description, then the praise.
//
// The order deliberately matches a jacket — you meet the object, you find out
// where to get it, then you read about it, then you read what other people
// said. Praise leads with one quote set large; the remainder is folded away so
// twelve endorsements never become the page.
import Page from '../../layouts/Page.astro';
import Flourish from '../../components/Flourish.astro';
import BookCover from '../../components/BookCover.astro';
import BuyBlock from '../../components/BuyBlock.astro';
import QuoteCarousel from '../../components/QuoteCarousel.astro';
import CarouselDots from '../../components/CarouselDots.astro';
import { books, splitTitle } from '../../data/books.js';
import { u } from '../../lib/url.js';

export function getStaticPaths() {
  // Authored first, newest first, then the edited volumes — the same order the
  // catalogue uses, so "next book" walks the page you just came from.
  const byYearDesc = (a, b) => Number(b.year) - Number(a.year);
  const ordered = [
    ...books.filter((b) => !b.role).sort(byYearDesc),
    ...books.filter((b) => b.role === 'editor').sort(byYearDesc),
  ];

  return ordered.map((book, i) => ({
    params: { slug: book.slug },
    props: {
      book,
      prev: ordered[i - 1] ?? null,
      next: ordered[i + 1] ?? null,
    },
  }));
}

const { book, prev, next } = Astro.props;
const t = splitTitle(book.title);

// The rotating quotes are set large, so they want the most quotable lines
// rather than whichever endorsements happen to come first — a sixty-word
// paragraph at display size is a wall, not a pull quote. Take the five
// shortest, then put them back into the order they were given in. The full set
// is still on the page, under the disclosure below.
const ROTATING = 5;
const shortest = new Set(
  [...book.endorsements].sort((a, b) => a.quote.length - b.quote.length).slice(0, ROTATING)
);
const rotating = book.endorsements.filter((e) => shortest.has(e));
const forthcoming = Number(book.year) > new Date().getFullYear();

const origin = Astro.site ?? 'http://localhost:4321';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: book.title,
  author: { '@type': 'Person', name: 'Ben Ware' },
  publisher: { '@type': 'Organization', name: book.publisher },
  datePublished: book.year,
  description: book.blurb,
  url: new URL(u(`/books/${book.slug}`), origin).href,
  ...(book.cover ? { image: new URL(u(book.cover), origin).href } : {}),
  ...(book.publishedAs ? { alternateName: book.publishedAs } : {}),
};
---

<Page
  title={`${book.shortTitle} — Ben Ware`}
  socialTitle={book.title}
  description={book.hook}
  schema={schema}
  image={book.cover ?? undefined}
>
  <p class="crumb">
    <a class="link link--sm" href={u('/books')}>← All books</a>
  </p>

  <!-- ------------------------------------------------------------------
       The title page: jacket left, imprint and title right, where to buy
       directly beneath.
  ------------------------------------------------------------------- -->
  <article class="title-page">
    <div class="title-page__plate">
      <BookCover book={book} loading="eager" />
    </div>

    <div class="title-page__text">
      <p class="label">
        {book.publisher} — {book.year}
        {book.role ? ` — ${book.role}` : ''}
      </p>

      <h1 class="title-page__title">
        {t.main}{t.sub && <span class="title-page__sub">{t.sub}</span>}
      </h1>

      {
        book.publishedAs && (
          /* Ben's own title is the one the site sets; Palgrave inverted it on
             the jacket, and he uses his original whenever he describes the
             book. Both are recorded so a search for either finds it. */
          <p class="title-page__alt">
            Published by {book.publisher} as <em>{book.publishedAs}</em>
          </p>
        )
      }

      {forthcoming && <p class="tag title-page__flag">Forthcoming</p>}

      <p class="lede title-page__hook">{book.hook}</p>

      <BuyBlock book={book} />
    </div>
  </article>

  <Flourish hand={1} />

  <section class="section" aria-labelledby="h-about">
    <h2 class="label" id="h-about">About the book</h2>

    <!-- The praise is floated into the description rather than stacked under
         it, so the paragraph runs around it the way a magazine sets a pull
         quote. A plain float is all this needs — CSS Shapes (shape-outside)
         only earns its keep when the text has to follow a non-rectangular
         edge, and a rectangle is the right shape here. The float comes first
         in the source because a float only affects the lines that follow it. -->
    <div class="about">
      {
        book.endorsements.length > 0 && (
          <aside class="about__praise" aria-labelledby="h-praise">
            <div class="about__praise-head">
              <h3 class="label" id="h-praise">
                Praise
              </h3>
              <CarouselDots name={`praise-${book.slug}`} quotes={rotating} />
            </div>
            <QuoteCarousel
              quotes={rotating}
              name={`praise-${book.slug}`}
              dots={false}
              interval={7000}
              label={`Praise for ${book.shortTitle}`}
            />
          </aside>
        )
      }

      <div class="prose prose--opening">
        <p>{book.blurb}</p>
      </div>
    </div>

    {
      book.endorsements.length > rotating.length && (
        <div class="praise__rest">
          <div id={`more-praise-${book.slug}`} class="praise__list" hidden>
            {book.endorsements.map((e) => (
              <blockquote class="praise__item">
                <p>{e.quote}</p>
                <cite set:html={e.source} />
              </blockquote>
            ))}
          </div>
          <button
            class="praise__toggle"
            type="button"
            aria-expanded="false"
            aria-controls={`more-praise-${book.slug}`}
            data-praise-toggle
            data-label-closed={`Read all ${book.endorsements.length} endorsements ↓`}
          >
            {`Read all ${book.endorsements.length} endorsements ↓`}
          </button>
        </div>
      )
    }
  </section>

  <!-- Turning the leaf: the neighbouring works, in catalogue order. -->
  <nav class="turn" aria-label="Other books">
    <hr class="hair" />
    <div class="turn__row">
      {
        prev ? (
          <a class="turn__link turn__link--prev" href={u(`/books/${prev.slug}`)}>
            <span class="label">Previous</span>
            <span class="turn__title">{prev.shortTitle}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a class="turn__link turn__link--next" href={u(`/books/${next.slug}`)}>
            <span class="label">Next</span>
            <span class="turn__title">{next.shortTitle}</span>
          </a>
        )
      }
    </div>
  </nav>
</Page>

<style>
  .crumb {
    margin: 0;
    padding-top: var(--sp-lg);
  }

  /* ------------------------------------------------------------------
     Title page
  ------------------------------------------------------------------ */

  .title-page {
    display: grid;
    grid-template-columns: clamp(11rem, 26vw, 17rem) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
    padding-block: var(--sp-lg) var(--sp-md);
  }

  .title-page__plate {
    --cover-h: clamp(13rem, 30vw, 21rem);
  }

  .title-page__title {
    margin-top: 0.5rem;
    font-size: clamp(2rem, 4.2vw, 3.25rem);
    letter-spacing: -0.012em;
    line-height: 1.08;
  }

  .title-page__sub {
    display: block;
    margin-top: 0.2em;
    font-size: 0.55em;
    line-height: 1.25;
    color: var(--ink-70);
  }

  .title-page__alt {
    margin: 0.8rem 0 0;
    font-size: 0.9375rem;
    color: var(--ink-60);
  }

  .title-page__flag {
    margin: 0.9rem 0 0;
  }

  .title-page__hook {
    margin-top: var(--sp-md);
  }

  /* ------------------------------------------------------------------
     Description — opened with a drop capital, as a chapter is, with the
     praise floated into the right-hand side of it.
  ------------------------------------------------------------------ */

  /* flow-root so the float is contained by the section instead of hanging
     into whatever follows. */
  .about {
    display: flow-root;
  }

  .about__praise {
    float: right;
    width: min(23rem, 44%);
    margin: 0.4rem 0 var(--sp-md) clamp(1.5rem, 4vw, 3.5rem);
  }

  /* Label and dials on one line, as on the homepage. */
  .about__praise-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-md);
    margin-bottom: 0.4rem;
  }

  .about__praise :global(.carousel) {
    margin-top: 0;
  }

  /* The float already sets the measure of the wrapped text; capping the prose
     as well would leave it a narrow ribbon. */
  .about .prose {
    max-width: none;
  }

  .prose--opening > p:first-of-type::first-letter {
    float: left;
    font-family: var(--display);
    font-size: 3.4em;
    line-height: 0.8;
    padding: 0.06em 0.1em 0 0;
  }

  /* ------------------------------------------------------------------
     Praise
  ------------------------------------------------------------------ */

  .praise__item cite {
    display: block;
    max-width: 52ch;
    margin-top: 0.7rem;
    font-style: normal;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-60);
  }

  .praise__item cite :global(em) {
    font-style: italic;
    text-transform: none;
    letter-spacing: 0.06em;
  }

  .praise__rest {
    clear: both;
    margin-top: var(--sp-xl);
  }

  .praise__list {
    columns: 2;
    column-gap: clamp(1.5rem, 4vw, 3rem);
    margin-bottom: var(--sp-md);
  }

  .praise__item {
    /* Keep a quote and its attribution in the same column. */
    break-inside: avoid;
    margin: 0 0 var(--sp-lg);
    padding-left: var(--sp-md);
    border-left: 1px solid var(--ink-18);
  }

  .praise__item p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
  }

  .praise__item p::before {
    content: '\201C';
  }

  .praise__item p::after {
    content: '\201D';
  }

  .praise__toggle {
    padding: 0 0 2px;
    border: 0;
    border-bottom: 1px solid var(--ink-25);
    background: none;
    cursor: pointer;
    font-family: var(--text);
    font-size: 0.9375rem;
    color: var(--ink);
    transition:
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .praise__toggle:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  @media (max-width: 46rem) {
    .title-page {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-lg);
    }

    .title-page__plate {
      width: min(100%, 15rem);
      --cover-h: clamp(11rem, 40vw, 15rem);
    }

    .praise__list {
      columns: 1;
    }

    /* Too narrow to wrap around: the praise goes back above the description. */
    .about__praise {
      float: none;
      width: auto;
      margin: 0 0 var(--sp-lg);
    }
  }

  /* ------------------------------------------------------------------
     Turning the leaf
  ------------------------------------------------------------------ */

  .turn {
    margin-top: var(--sp-2xl);
  }

  .turn__row {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-lg);
    padding-top: var(--sp-md);
  }

  .turn__link--next {
    text-align: right;
    margin-left: auto;
  }

  .turn__title {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--display);
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    line-height: 1.2;
    transition: color var(--dur) var(--ease);
  }

  .turn__link:hover .turn__title {
    color: var(--accent);
  }
</style>

<script>
  // Plain-JS disclosure for the remaining endorsements.
  document.querySelectorAll('[data-praise-toggle]').forEach((button) => {
    const list = document.getElementById(button.getAttribute('aria-controls'));
    const closed = button.dataset.labelClosed;
    button.addEventListener('click', () => {
      const expanded = button.getAttribute('aria-expanded') === 'true';
      list.hidden = expanded;
      button.setAttribute('aria-expanded', String(!expanded));
      button.textContent = expanded ? closed : 'Show less ↑';
    });
  });
</script>
