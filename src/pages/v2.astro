---
// VERSION 2 — "The Manuscript"
// The homepage as a page of Ben's own typescript, old-web simple. The hero
// is a split leaf: profile on the left — name and role in small type, the
// opening note, the interview quote as an epigraph, the scroll cue — and
// the books as a captioned cover grid on the right. No display type, no
// typing animation: the page simply is. Scrolling down: the interviews,
// then the articles as a table of contents with dot leaders — undated
// pieces marked "TK", the manuscript convention for "to come" — and a
// centred "Next: Biography" sign-off. Courier Prime is the voice
// throughout; Spectral survives only in the epigraph. Arrow system and
// outbound cursor chip carried over from V1.
import Base from '../layouts/Base.astro';
import { bookBySlug, v1Order } from '../data/books.js';
import { writing, interviews, videos } from '../data/writing.js';

const sequence = v1Order.map((slug, i) => ({
  ...bookBySlug[slug],
  index: String(i + 1).padStart(2, '0'),
}));

const recentWriting = writing.slice(0, 6);

// YouTube/Vimeo → privacy-friendly embed URL; anything else (IAI) gets a
// typographic link card instead of a player. Same helper as V1.
function embedUrl(url) {
  const yt = url.match(/[?&]v=([\w-]+)/);
  if (yt) return `https://www.youtube-nocookie.com/embed/${yt[1]}`;
  const vm = url.match(/vimeo\.com\/(\d+)/);
  if (vm) return `https://player.vimeo.com/video/${vm[1]}`;
  return null;
}

// Talk titles carry their venue in a trailing parenthetical — split it out so
// the rows read like the bibliography entries above them.
function splitTalk(title) {
  const m = title.match(/^(.*?)\s*\(([^()]*)\)\s*$/);
  return m ? { title: m[1], meta: m[2] } : { title, meta: null };
}

const talks = videos.map((v, i) => ({
  ...v,
  ...splitTalk(v.title),
  fullTitle: v.title,
  index: String(i + 1).padStart(2, '0'),
  embed: embedUrl(v.url),
}));
const leadTalk = talks[0];

const year = new Date().getFullYear();
import { u } from '../lib/url.js';
---

<Base title="Ben Ware — Philosopher and social theorist">
  <main class="v2">
    <nav class="v2-nav" aria-label="Main">
      <a class="v2-nav__logo" href={u('/v2')}>Ben Ware</a>
      <ul>
        <li><a href={u('/books')}>Books</a></li>
        <li><a href={u('/writing')}>Media</a></li>
        <li><a href={u('/biog')}>Biog</a></li>
      </ul>
    </nav>

    <!-- ------------------------------------------------------------------
         Hero: a split leaf. Profile on the left — name, role, the opening
         note, the epigraph quote, the scroll cue — all small type; the
         books as a captioned cover grid on the right.
    ------------------------------------------------------------------- -->
    <section class="v2-hero" aria-label="Ben Ware">
      <div class="v2-hero__profile">
        <header class="v2-hero__id">
          <h1 class="v2-hero__name">Ben Ware</h1>
          <p class="v2-hero__role">
            Philosopher &amp; social theorist<br />
            London, UK
          </p>
        </header>

        <p class="v2-hero__note">
          Writing on <a href={u('/books#on-extinction')}>extinction</a>,
          <a href={u('/books#living-wrong-life-rightly')}>modernism</a>, and the art of
          <a href={u('/books#bacon-disfigured')}>Francis&nbsp;Bacon</a>. Co-Director of the
          Centre for Philosophy and Art at King's College London.
        </p>

        <div class="v2-hero__epigraph">
          <a
            class="v2-quote"
            href={u(interviews[0].url)}
            target="_blank"
            rel="noopener"
            data-todo="interview-quote-verify"
          >
            <blockquote class="v2-quote__text">
              “Hell is not something that awaits us, but this life here and now.”
            </blockquote>
            <span class="v2-quote__attr eyebrow">
              — Welcome to Hell, in conversation with Shane Anderson, 032C
              <svg class="arr arr--out" viewBox="0 0 16 16" aria-hidden="true"><path class="arr__shaft" d="M2.5 13.5 11.5 4.5" /><path class="arr__head" pathLength="16" d="M5.5 3.5H12.5V10.5" /></svg>
            </span>
          </a>
        </div>

        <p class="v2-hero__scroll eyebrow" aria-hidden="true">Scroll ↓</p>
      </div>

      <ul class="v2-hero__books" aria-label="Books">
        {
          sequence.map((book) => (
            <li>
              <a
                class="v2-hero__book"
                href={u(`/books#${book.slug}`)}
                aria-label={`${book.shortTitle} — view book`}
              >
                <img
                  class="v2-hero__cover"
                  src={u(book.cover)}
                  alt={`Cover of ${book.shortTitle}`}
                  loading="eager"
                  data-todo={book.coverIsPlaceholder ? 'cover-living-wrong-life' : undefined}
                />
                <span class="v2-hero__caption eyebrow">
                  {book.shortTitle}, {book.year}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="v2-sheet">
      <!-- Interviews: bibliography rows in the hero's register — small
           label column left, entries right, venue trailing the title. -->
      <section class="v2-block" id="interviews" data-reveal aria-label="Interviews">
        <h2 class="v2-block__label" data-reveal-item>Interviews</h2>
        <ol class="v2-list">
          {
            interviews.map((item) => (
              <li data-reveal-item>
                <a class="v2-list__row" href={u(item.url)} target="_blank" rel="noopener">
                  <span class="v2-list__title">{item.title}</span>
                  <span class="v2-list__meta eyebrow">— {item.venue}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- Articles: same rows; undated pieces read "TK" — to come. -->
      <section class="v2-block" id="writing" data-reveal aria-label="Articles">
        <h2 class="v2-block__label" data-reveal-item>Articles</h2>
        <ol class="v2-list">
          {
            recentWriting.map((item) => (
              <li data-reveal-item>
                {item.url ? (
                  <a class="v2-list__row" href={u(item.url)} target="_blank" rel="noopener">
                    <span class="v2-list__title">{item.title}</span>
                    <span class="v2-list__meta eyebrow">
                      — {item.pdf && !item.venue ? 'PDF' : item.venue}{item.year ? `, ${item.year}` : ''}
                    </span>
                  </a>
                ) : (
                  <span class="v2-list__row v2-list__row--pending" data-todo="writing-link">
                    <span class="v2-list__title">{item.title}</span>
                    <span class="v2-list__meta eyebrow">— TK</span>
                  </span>
                )}
              </li>
            ))
          }
        </ol>
        <p class="v2-block__more" data-reveal-item>
          <a class="v2-explore" href={u('/writing')}
            >Explore Writing <svg class="arr arr--to" viewBox="0 0 16 16" aria-hidden="true"><path class="arr__shaft" d="M1.5 8H12" /><path class="arr__head" pathLength="16" d="M8 2.5 13.5 8 8 13.5" /></svg></a
          >
        </p>
      </section>

      <!-- Talks: the lead recording plays in the hero's grey mat, captioned
           like a book cover; the rest fall in as bibliography rows so the
           section still reads as part of the typescript. -->
      <section class="v2-block" id="talks" data-reveal aria-label="Talks">
        <h2 class="v2-block__label" data-reveal-item>Talks</h2>
        <div class="v2-talks">
          <figure class="v2-talk" data-reveal-item>
            <span class="v2-talk__mat">
              {
                leadTalk.embed ? (
                  <iframe
                    src={u(leadTalk.embed)}
                    title={leadTalk.fullTitle}
                    loading="lazy"
                    allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                  />
                ) : (
                  <a class="v2-talk__linkcard" href={u(leadTalk.url)} target="_blank" rel="noopener">
                    <span class="v2-talk__linkcard-title">{leadTalk.title}</span>
                    <span class="eyebrow"
                      >Watch <svg class="arr arr--out" viewBox="0 0 16 16" aria-hidden="true"><path class="arr__shaft" d="M2.5 13.5 11.5 4.5" /><path class="arr__head" pathLength="16" d="M5.5 3.5H12.5V10.5" /></svg></span
                    >
                  </a>
                )
              }
            </span>
            <figcaption class="v2-talk__caption eyebrow">
              {leadTalk.index} — {leadTalk.title}{leadTalk.meta ? `, ${leadTalk.meta}` : ''}
            </figcaption>
          </figure>

          <p class="v2-talk__blurb" data-reveal-item>
            Lectures and conversations on extinction, the death drive and
            Wittgenstein's modernism — recorded at HowTheLightGetsIn, BICAR and the
            British Wittgenstein Society. {talks.length} in all.
          </p>
        </div>
        <p class="v2-block__more" data-reveal-item>
          <a class="v2-explore" href={u('/writing')}
            >Explore Talks <svg class="arr arr--to" viewBox="0 0 16 16" aria-hidden="true"><path class="arr__shaft" d="M1.5 8H12" /><path class="arr__head" pathLength="16" d="M8 2.5 13.5 8 8 13.5" /></svg></a
          >
        </p>
      </section>

      <!-- The sign-off: the ask, set on the same seam as every section
           above it — label left, the ask in the entries column. -->
      <section class="v2-block v2-cta" data-reveal aria-labelledby="enquiries-label">
        <h2 class="v2-block__label" id="enquiries-label" data-reveal-item>Enquiries</h2>
        <div class="v2-cta__body">
          <p class="v2-asterism" aria-hidden="true" data-reveal-item>* * *</p>
          <p class="v2-cta__text" data-reveal-item>
            For speaking, press and rights, Ben is represented by
            <a
              class="v2-cta__link"
              href="https://cwagency.co.uk"
              target="_blank"
              rel="noopener"
              data-todo="verify-cw-url"
              >C&amp;W Agency <svg class="arr arr--out" viewBox="0 0 16 16" aria-hidden="true"><path class="arr__shaft" d="M2.5 13.5 11.5 4.5" /><path class="arr__head" pathLength="16" d="M5.5 3.5H12.5V10.5" /></svg></a
            >.
          </p>
          <p class="v2-cta__note eyebrow" data-reveal-item data-todo="enquiries-email">
            Direct email — TK
          </p>
        </div>
      </section>

      <footer class="v2-footer" data-reveal>
        <hr class="rule" />
        <!-- The foot keeps the seam: imprint in the label column, the
             navigation columns in the entries column. -->
        <div class="v2-footer__grid">
          <div class="v2-footer__imprint" data-reveal-item>
            <span class="eyebrow">© {year} Ben Ware</span>
            <span class="eyebrow">London, UK</span>
          </div>

          <div class="v2-footer__cols">
            <nav class="v2-footer__col" aria-labelledby="foot-site">
              <h2 class="eyebrow" id="foot-site" data-reveal-item>Site</h2>
              <ul data-reveal-item>
                <li><a href={u('/books')}>Books</a></li>
                <li><a href={u('/writing')}>Media</a></li>
                <li><a href={u('/biog')}>Biog</a></li>
              </ul>
            </nav>

            <nav class="v2-footer__col" aria-labelledby="foot-elsewhere">
              <h2 class="eyebrow" id="foot-elsewhere" data-reveal-item>Elsewhere</h2>
              <ul data-reveal-item>
                <li>
                  <a
                    href="https://www.kcl.ac.uk/research/centre-for-philosophy-and-visual-arts"
                    target="_blank"
                    rel="noopener"
                    >Centre for Philosophy &amp; Art <svg class="arr arr--out" viewBox="0 0 16 16" aria-hidden="true"><path class="arr__shaft" d="M2.5 13.5 11.5 4.5" /><path class="arr__head" pathLength="16" d="M5.5 3.5H12.5V10.5" /></svg></a
                  >
                </li>
                <li>
                  <a href="https://www.bicar.org" target="_blank" rel="noopener" data-todo="verify-bicar-url"
                    >BICAR <svg class="arr arr--out" viewBox="0 0 16 16" aria-hidden="true"><path class="arr__shaft" d="M2.5 13.5 11.5 4.5" /><path class="arr__head" pathLength="16" d="M5.5 3.5H12.5V10.5" /></svg></a
                  >
                </li>
              </ul>
            </nav>
          </div>
        </div>
      </footer>
    </div>

    <!-- Outbound cursor chip, unchanged from V1. -->
    <div class="v2-cursor" aria-hidden="true">
      <div class="v2-cursor__disc">
        <svg class="arr" viewBox="0 0 16 16">
          <path class="arr__shaft" d="M2.5 13.5 11.5 4.5" />
          <path class="arr__head" pathLength="16" d="M5.5 3.5H12.5V10.5" />
        </svg>
      </div>
    </div>
  </main>

  <!-- V2 sits on white rather than the site's warm paper. Scoped to this
       page, so the other concepts keep the shared tone. -->
  <style is:global>
    html body {
      background: #ffffff;
    }
  </style>

  <style>
    .v2 {
      --v2-nav-h: clamp(3.5rem, 9vh, 5.5rem);
      /* Overrides the shared token for this page only — the sticky nav and
         everything else inside .v2 reads it. */
      --color-paper: #ffffff;
      --v2-mat: #ededeb; /* neutral grey mat, since the paper no longer warms it */
      --v2-wide: 66rem; /* the footer rule runs a little wider */
    }

    .v2-nav {
      position: sticky;
      top: 0;
      z-index: 20;
      height: var(--v2-nav-h);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-inline: var(--gutter);
      background: var(--color-paper);
    }

    .v2-nav__logo {
      font-family: var(--font-body);
      font-weight: 700;
      font-size: clamp(1rem, 1.6vw, 1.35rem);
      opacity: 0;
      transform: translateY(0.4rem);
      pointer-events: none;
      transition:
        opacity 0.4s var(--ease-standard),
        transform 0.4s var(--ease-standard);
    }

    .v2-nav.has-logo .v2-nav__logo {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }

    .v2-nav ul {
      display: flex;
      gap: clamp(1.25rem, 2.4vw, 3rem);
      list-style: none;
      margin: 0;
      padding: 0;
      font-family: var(--font-body);
      font-size: clamp(0.95rem, 1.6vw, 1.25rem);
    }

    @media (prefers-reduced-motion: reduce) {
      .v2-nav__logo {
        transition: none;
      }
    }

    /* ------------------------------------------------------------------
       Hero: the split leaf. Profile column of small type on the left —
       name at the top, note beneath, epigraph and scroll cue pushed to
       the foot — the books as a captioned cover grid on the right.
    ------------------------------------------------------------------ */

    .v2-hero {
      min-height: calc(100svh - var(--v2-nav-h));
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(2.5rem, 6vw, 6rem);
      padding: clamp(1.5rem, 4vh, 3rem) var(--gutter) clamp(2rem, 5vh, 3.5rem);
    }

    .v2-hero__profile {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }

    .v2-hero__name {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 0.8125rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .v2-hero__role {
      margin: 0.6rem 0 0;
      font-family: var(--font-display);
      font-size: var(--text-xs);
      letter-spacing: 0.18em;
      text-transform: uppercase;
      line-height: 2;
      color: var(--color-ink-55);
    }

    .v2-hero__note {
      margin: clamp(2.5rem, 7vh, 4.5rem) 0 0;
      max-width: 36ch;
      font-family: var(--font-body);
      font-size: 0.9375rem;
      line-height: 1.8;
    }

    .v2-hero__note a {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.22em;
    }

    /* The one serif survivor, at the foot of the profile column. */

    .v2-hero__epigraph {
      margin-top: auto;
      padding-top: clamp(2rem, 5vh, 3rem);
      width: min(100%, 36ch);
    }

    .v2-quote {
      display: block;
    }

    .v2-quote__text {
      margin: 0 0 0.9rem;
      font-family: 'Spectral', Georgia, serif;
      font-weight: 300;
      font-style: italic;
      font-size: clamp(1rem, 1.4vw, 1.2rem);
      line-height: 1.65;
      letter-spacing: -0.01em;
      transition: color 0.3s var(--ease-standard);
    }

    a.v2-quote:hover .v2-quote__text {
      color: var(--color-accent);
    }

    .v2-quote__attr {
      display: block;
      line-height: 1.7;
    }

    @media (prefers-reduced-motion: reduce) {
      .v2-quote__text {
        transition: none;
      }
    }

    .v2-hero__scroll {
      margin: clamp(2rem, 5vh, 3rem) 0 0;
    }

    /* The books: covers straight on the paper, captions always set.
       The grid starts on the same seam as the section entries below, and
       its top edge sits level with the name — one horizontal line across
       the leaf, whatever the viewport does. */

    .v2-hero__books {
      list-style: none;
      margin: 0;
      padding: 0;
      justify-self: start;
      align-self: start;
      width: min(100%, 36rem);
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1.5rem, 3vh, 2.25rem) clamp(1rem, 2vw, 1.75rem);
    }

    .v2-hero__book {
      display: block;
    }

    .v2-hero__cover {
      width: 100%;
      aspect-ratio: 2 / 3;
      object-fit: cover;
      background: var(--v2-mat);
    }

    .v2-hero__caption {
      display: block;
      margin-top: 0.55rem;
      transition: color 0.3s var(--ease-standard);
    }

    .v2-hero__book:hover .v2-hero__caption,
    .v2-hero__book:focus-visible .v2-hero__caption {
      color: var(--color-accent);
    }

    @media (prefers-reduced-motion: reduce) {
      .v2-hero__caption {
        transition: none;
      }
    }

    /* ------------------------------------------------------------------
       The sheet: one centred typed column.
    ------------------------------------------------------------------ */

    .v2-sheet {
      display: flex;
      flex-direction: column;
      gap: clamp(4.5rem, 12vh, 8rem);
      padding: clamp(3rem, 8vh, 6rem) var(--gutter) clamp(3rem, 7vh, 5rem);
    }

    /* Sections mirror the hero's split: the label sits in the profile
       column, set exactly like the name; the entries take the books'
       column. One seam runs the length of the page. */

    .v2-block {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(1.5rem, 4vh, 2.5rem) clamp(2.5rem, 6vw, 6rem);
      align-items: start;
    }

    .v2-block__label {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 0.8125rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .v2-asterism {
      margin: 0 0 clamp(2.5rem, 6vh, 4rem);
      font-family: var(--font-display);
      text-align: center;
      letter-spacing: 0.6ch;
      color: var(--color-ink-55);
    }

    /* Entries: bibliography rows in the note's type — the venue trails
       the title in an eyebrow, wrapping with the text. */

    .v2-list {
      list-style: none;
      padding: 0;
      margin-block: 0;
      max-width: 60ch;
      display: flex;
      flex-direction: column;
      gap: clamp(1.1rem, 2.5vh, 1.6rem);
    }

    .v2-list__row {
      display: block;
    }

    .v2-list__title {
      font-family: var(--font-body);
      font-size: 0.9375rem;
      line-height: 1.7;
      transition: color 0.3s var(--ease-standard);
    }

    a.v2-list__row:hover .v2-list__title {
      color: var(--color-accent);
    }

    .v2-list__meta {
      margin-left: 1ch;
    }

    @media (prefers-reduced-motion: reduce) {
      .v2-list__title {
        transition: none;
      }
    }

    /* Talks: one recording in the same grey mat as the covers, captioned in
       the eyebrow, with a line of note beneath — the rest live on /writing. */

    .v2-talks {
      display: flex;
      flex-direction: column;
      gap: clamp(1.5rem, 4vh, 2.25rem);
      max-width: 60ch;
    }

    .v2-talk {
      margin: 0;
    }

    .v2-talk__mat {
      display: block;
      background: var(--v2-mat);
      padding: clamp(0.75rem, 2vw, 1.5rem);
    }

    .v2-talk__mat iframe {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 9;
      border: 0;
      background: var(--color-ink);
    }

    /* Fallback for venues that refuse embedding (IAI): a typed card. */
    .v2-talk__linkcard {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 1.5rem;
      aspect-ratio: 16 / 9;
      padding: clamp(1rem, 2vw, 1.75rem);
    }

    .v2-talk__linkcard-title {
      font-family: var(--font-body);
      font-size: 0.9375rem;
      line-height: 1.7;
      transition: color 0.3s var(--ease-standard);
    }

    .v2-talk__linkcard:hover .v2-talk__linkcard-title {
      color: var(--color-accent);
    }

    .v2-talk__caption {
      display: block;
      margin-top: 0.55rem;
    }

    .v2-talk__blurb {
      margin: 0;
      max-width: 52ch;
      font-family: var(--font-body);
      font-size: 0.9375rem;
      line-height: 1.8;
    }

    @media (prefers-reduced-motion: reduce) {
      .v2-talk__linkcard-title {
        transition: none;
      }
    }

    /* Custom arrows — identical system to V1: thick → for in-site links
       resting as a square dot, outbound ↗ with corner-bracket head. */

    .arr {
      display: inline-block;
      width: 0.85em;
      height: 0.85em;
      vertical-align: -0.06em;
      overflow: visible;
      fill: none;
      stroke: currentColor;
      stroke-width: 2.2;
      stroke-linecap: square;
    }

    .arr .arr__shaft {
      --len: 13;
      stroke-dasharray: var(--len);
      stroke-dashoffset: 0;
    }

    .arr .arr__head {
      stroke-dasharray: 16 16;
      stroke-dashoffset: 0;
      stroke-linecap: butt;
    }

    @keyframes v2-draw {
      from {
        stroke-dashoffset: var(--len);
      }
      to {
        stroke-dashoffset: 0;
      }
    }

    @keyframes v2-draw-head {
      from {
        stroke-dasharray: 0 16;
        stroke-dashoffset: -8;
      }
      to {
        stroke-dasharray: 16 16;
        stroke-dashoffset: 0;
      }
    }

    .arr--to .arr__shaft {
      stroke-dashoffset: calc(var(--len) - 0.011);
      transition: stroke-dashoffset 0.08s 0.12s var(--ease-standard);
    }

    .arr--to .arr__head {
      stroke-dasharray: 0 16;
      stroke-dashoffset: -8;
      transition:
        stroke-dasharray 0.13s var(--ease-standard),
        stroke-dashoffset 0.13s var(--ease-standard);
    }

    a:hover .arr--to .arr__shaft {
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 0.12s var(--ease-standard);
    }

    a:hover .arr--to .arr__head {
      stroke-dasharray: 16 16;
      stroke-dashoffset: 0;
      transition:
        stroke-dasharray 0.2s 0.1s var(--ease-standard),
        stroke-dashoffset 0.2s 0.1s var(--ease-standard);
    }

    a:hover .arr--out .arr__shaft {
      animation: v2-draw 0.12s var(--ease-standard) both;
    }

    a:hover .arr--out .arr__head {
      animation: v2-draw-head 0.2s 0.1s var(--ease-standard) both;
    }

    /* Outbound cursor chip. */

    .v2-cursor {
      position: fixed;
      top: -24px;
      left: -24px;
      width: 48px;
      height: 48px;
      pointer-events: none;
      z-index: 60;
      will-change: transform;
    }

    .v2-cursor__disc {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      background: var(--color-ink);
      color: #ffffff;
      display: grid;
      place-items: center;
      opacity: 0;
      transform: scale(0.4);
      transition:
        opacity 0.2s var(--ease-standard),
        transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .v2-cursor.is-active .v2-cursor__disc {
      opacity: 1;
      transform: scale(1);
    }

    .v2-cursor svg {
      width: 18px;
      height: 18px;
    }

    .v2-cursor.is-active .arr__shaft {
      animation: v2-draw 0.1s 0.05s var(--ease-standard) both;
    }

    .v2-cursor.is-active .arr__head {
      animation: v2-draw-head 0.16s 0.14s var(--ease-standard) both;
    }

    @media (prefers-reduced-motion: reduce) {
      a:hover .arr--out .arr__shaft,
      a:hover .arr--out .arr__head,
      .v2-cursor.is-active .arr__shaft,
      .v2-cursor.is-active .arr__head {
        animation: none;
      }

      .arr--to .arr__shaft {
        stroke-dashoffset: 0;
        transition: none;
      }

      .arr--to .arr__head {
        stroke-dasharray: 16 16;
        stroke-dashoffset: 0;
        transition: none;
      }

      .v2-cursor__disc {
        transition: opacity 0.25s var(--ease-standard);
        transform: none;
      }
    }

    /* Explore links: typed pulls closing each section, centred. */

    .v2-explore {
      display: inline-block;
      font-family: var(--font-body);
      font-weight: 400;
      font-size: clamp(0.95rem, 1.3vw, 1.2rem);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-decoration-color: var(--color-ink-15);
      text-underline-offset: 5px;
      transition:
        color 0.3s var(--ease-standard),
        text-decoration-color 0.3s var(--ease-standard);
    }

    .v2-explore:hover {
      color: var(--color-accent);
      text-decoration-color: var(--color-accent);
    }

    .v2-block__more {
      grid-column: 2;
      margin: clamp(1rem, 3vh, 2rem) 0 0;
    }

    /* The ask: an ordinary block on the page seam — label left, the ask in
       the entries column, one step up from the body and nowhere near
       display scale. The sheet closes, it doesn't shout. */

    .v2-cta__body {
      max-width: 60ch;
    }

    .v2-cta .v2-asterism {
      margin: 0 0 clamp(1.5rem, 4vh, 2.5rem);
      text-align: left;
    }

    .v2-cta__text {
      margin: 0;
      max-width: 44ch;
      font-family: var(--font-body);
      font-size: clamp(1.05rem, 1.8vw, 1.5rem);
      line-height: 1.6;
    }

    .v2-cta__link {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-decoration-color: var(--color-ink-15);
      text-underline-offset: 0.22em;
      transition:
        color 0.3s var(--ease-standard),
        text-decoration-color 0.3s var(--ease-standard);
    }

    .v2-cta__link:hover {
      color: var(--color-accent);
      text-decoration-color: var(--color-accent);
    }

    .v2-cta__note {
      margin: clamp(1.25rem, 3vh, 2rem) 0 0;
    }

    @media (prefers-reduced-motion: reduce) {
      .v2-cta__link {
        transition: none;
      }
    }

    /* Footer: the foot of the sheet, on the same seam — imprint in the label
       column, navigation in the entries column. */

    .v2-footer__grid {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(2rem, 5vh, 3rem) clamp(2.5rem, 6vw, 6rem);
      align-items: start;
      padding-top: clamp(2rem, 5vh, 3rem);
    }

    .v2-footer__imprint {
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
    }

    .v2-footer__cols {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(2rem, 5vw, 4rem);
    }

    .v2-footer__col h2 {
      margin: 0 0 1rem;
    }

    .v2-footer__col ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
    }

    .v2-footer__col a {
      font-family: var(--font-body);
      font-size: 0.9375rem;
      line-height: 1.6;
      transition: color 0.3s var(--ease-standard);
    }

    .v2-footer__col a:hover {
      color: var(--color-accent);
    }

    @media (prefers-reduced-motion: reduce) {
      .v2-footer__col a {
        transition: none;
      }
    }

    /* The split leaf stacks: profile first, then the cover grid at two
       across. The epigraph gives up its push to the column foot. */
    @media (max-width: 760px) {
      .v2-hero {
        grid-template-columns: minmax(0, 1fr);
      }

      .v2-hero__epigraph {
        margin-top: 0;
        padding-top: clamp(2rem, 5vh, 3rem);
      }

      .v2-hero__books {
        justify-self: start;
        align-self: start;
        width: min(100%, 26rem);
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      /* Sections stack the same way: label above the entries. */
      .v2-block {
        grid-template-columns: minmax(0, 1fr);
      }

      .v2-block__more {
        grid-column: 1;
      }

      /* The foot stacks too: navigation first, imprint last. */
      .v2-footer__grid {
        grid-template-columns: minmax(0, 1fr);
      }

      .v2-footer__imprint {
        order: 2;
        flex-direction: row;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }
    }
  </style>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    // Nav logo appears once the hero's name block has scrolled out of view.
    const nav = document.querySelector('.v2-nav');
    const heroId = document.querySelector('.v2-hero__id');
    const updateLogo = () => {
      const gone = heroId.getBoundingClientRect().bottom < nav.offsetHeight;
      nav.classList.toggle('has-logo', gone);
    };
    updateLogo();
    window.addEventListener('scroll', updateLogo, { passive: true });

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Outbound cursor chip — identical to V1.
    const chip = document.querySelector('.v2-cursor');
    if (chip && !reduceMotion && window.matchMedia('(pointer: fine)').matches) {
      let x = 0;
      let y = 0;
      let cx = 0;
      let cy = 0;
      let over = false;
      let raf = null;

      const render = () => {
        cx += (x - cx) * 0.22;
        cy += (y - cy) * 0.22;
        chip.style.transform = `translate(${cx + 30}px, ${cy - 30}px)`;
        if (over || Math.hypot(x - cx, y - cy) > 0.5) {
          raf = requestAnimationFrame(render);
        } else {
          raf = null;
        }
      };
      const start = () => {
        if (raf === null) raf = requestAnimationFrame(render);
      };

      document.addEventListener(
        'mousemove',
        (e) => {
          x = e.clientX;
          y = e.clientY;
          if (over) start();
        },
        { passive: true }
      );

      document.querySelectorAll('a[target="_blank"]').forEach((link) => {
        link.addEventListener('mouseenter', () => {
          over = true;
          cx = x;
          cy = y;
          chip.classList.add('is-active');
          start();
        });
        link.addEventListener('mouseleave', () => {
          over = false;
          chip.classList.remove('is-active');
        });
      });
    }

    if (!reduceMotion) {
      gsap.registerPlugin(ScrollTrigger);

      // Sections fade up as they enter; items stagger within them.
      document.querySelectorAll('[data-reveal]').forEach((section) => {
        const items = section.querySelectorAll('[data-reveal-item]');
        gsap.from(items.length ? items : section, {
          y: 32,
          autoAlpha: 0,
          duration: 0.8,
          stagger: 0.07,
          ease: 'power3.out',
          scrollTrigger: { trigger: section, start: 'top 85%' },
        });
      });
    }
  </script>
</Base>
