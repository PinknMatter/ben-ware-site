---
// The homepage — "The Frontispiece".
//
// In classical book design the frontispiece, an engraved portrait, faces the
// title page, so the reader meets the author and the title in one spread. That
// is the hero: the portrait mounted as a plate on the left, the title block on
// the right. Below it the page turns scholarly — small-caps heads, ranged
// lists, a wide column for the books because they are the reason to be here.
//
// The flair is one pen, used sparingly: the rule under the name, the
// signature, and the rules between sections.
import Page from '../layouts/Page.astro';
import Flourish from '../components/Flourish.astro';
import Signature from '../components/Signature.astro';
import BookCover from '../components/BookCover.astro';
import QuoteCarousel from '../components/QuoteCarousel.astro';
import CarouselDots from '../components/CarouselDots.astro';
import { books, booksByYear, splitTitle } from '../data/books.js';
import { writing, interviews, videos } from '../data/writing.js';
import { site, affiliations, representation } from '../data/site.js';
import { u } from '../lib/url.js';

// On Extinction leads: the single-authored trade book, and the one the lede
// already points at. The rest follow as a run of covers.
const lead = books.find((b) => b.slug === 'on-extinction') ?? booksByYear[0];
const shelf = booksByYear.filter((b) => b !== lead);
const leadTitle = splitTitle(lead.title);

// Five pieces that are actually readable — a homepage should not list things
// you cannot click.
const selectedWriting = writing.filter((w) => w.url && w.venue).slice(0, 5);

const media = [
  ...interviews.map((i) => ({
    title: i.title,
    meta: [i.venue, i.with].filter(Boolean).join(', '),
    url: i.url,
  })),
  ...videos.slice(0, 3).map((v) => ({
    title: v.title,
    meta: v.venue ?? v.with,
    url: v.url,
  })),
];

const origin = Astro.site ?? 'http://localhost:4321';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  description: site.description,
  url: new URL(u('/'), origin).href,
  image: new URL(u('/images/ben-ware-portrait.jpg'), origin).href,
  affiliation: affiliations.map((a) => ({ '@type': 'Organization', name: a.org, url: a.url })),
  knowsAbout: ['Philosophy', 'Critical theory', 'Psychoanalysis', 'Modernism', 'Ethics'],
};
---

<Page title="Ben Ware — Philosopher and social theorist" socialTitle="Ben Ware" schema={schema}>
  <!-- ------------------------------------------------------------------
       Frontispiece: the plate faces the title block. Ben looks toward frame
       right, so the portrait takes the left and his eyeline runs into the
       type.
  ------------------------------------------------------------------- -->
  <section class="frontis" aria-label={site.name}>
    <figure class="plate frontis__plate">
      <span class="plate__mount">
        <img
          src={u('/images/ben-ware-portrait.jpg')}
          alt="Ben Ware"
          width="759"
          height="986"
          loading="eager"
          fetchpriority="high"
        />
      </span>

      <!-- A plate caption credits the engraver; here it wants the
           photographer, once the client supplies the name. -->
      <figcaption class="plate__caption" data-todo="portrait-credit">{site.place}</figcaption>
    </figure>

    <div class="title">
      <h1 class="title__name">{site.name}</h1>

      <Flourish variant="short" draw={false} data-intro="1" />

      <!-- Ben's own sequence for the opening: the two roles set upright, then
           a line of his in italics, then his signature. The quote is from On
           Extinction and he asked for it unattributed here — on his own page
           it reads as him speaking, not as a citation. -->
      <p class="title__role">{site.role}</p>
      <p class="title__role">{site.appointment}</p>

      <blockquote class="title__quote">
        <p>{site.statement}</p>
      </blockquote>

      <Signature data-intro="2" />
    </div>
  </section>

  <Flourish hand={0} />

  <!-- ------------------------------------------------------------------
       Books, given the widest column on the page: the lead title set as a
       proper book announcement — cover, imprint, praise — and the rest as a
       run of covers on a shelf. Nothing ruled here, so this section reads as
       pictures where the two below read as bibliography.
  ------------------------------------------------------------------- -->
  <section class="section" id="books" aria-labelledby="h-books">
    <h2 class="label" id="h-books">Books</h2>

    <article class="lead">
      <a class="lead__cover" href={u(`/books/${lead.slug}`)} tabindex="-1" aria-hidden="true">
        <BookCover book={lead} decorative />
      </a>
      <div class="lead__text">
        <p class="label">{lead.publisher} — {lead.year}</p>

        <!-- The dials belong to the carousel below, but they are set here so
             they sit on the subtitle's line. QuoteCarousel finds them by name. -->
        <div class="lead__titling">
          <h3 class="lead__title">
            <a href={u(`/books/${lead.slug}`)}>
              {leadTitle.main}{leadTitle.sub && <span class="lead__sub">{leadTitle.sub}</span>}
            </a>
          </h3>
          <CarouselDots name="lead-praise" quotes={lead.praiseShort} class="lead__dots" />
        </div>

        <!-- The client asked for the description under this title to become a
             rotating set of endorsements. -->
        <QuoteCarousel
          quotes={lead.praiseShort}
          name="lead-praise"
          dots={false}
          label={`Praise for ${lead.shortTitle}`}
        />

        <p class="more">
          <a class="link link--sm" href={u(`/books/${lead.slug}`)}>Read more</a>
        </p>
      </div>
    </article>

    <ul class="shelf">
      {
        shelf.map((book) => (
          <li>
            <a class="shelf__item" href={u(`/books/${book.slug}`)}>
              <BookCover book={book} decorative />
              <span class="shelf__title">{book.shortTitle}</span>
              <span class="shelf__meta">
                {book.publisher}, {book.year}
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="more">
      <a class="link link--sm" href={u('/books')}>All books</a>
    </p>
  </section>

  <Flourish hand={1} />

  <section class="section" id="writing" aria-labelledby="h-writing">
    <h2 class="label" id="h-writing">Recent essays</h2>
    <ol class="entries">
      {
        selectedWriting.map((item) => (
          <li>
            <a class="entry entry--plain" href={u(item.url)} target="_blank" rel="noopener">
              <span class="entry__text">
                <span class="entry__title">{item.title}</span>
                <span class="entry__meta">{item.venue}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
    <p class="more">
      <a class="link link--sm" href={u('/writing')}>More</a>
    </p>
  </section>

  <Flourish hand={2} />

  <section class="section" id="media" aria-labelledby="h-media">
    <h2 class="label" id="h-media">Media</h2>
    <ul class="entries">
      {
        media.map((item) => (
          <li>
            <a class="entry entry--plain" href={item.url} target="_blank" rel="noopener">
              <span class="entry__text">
                <span class="entry__title">{item.title}</span>
                {item.meta && <span class="entry__meta">{item.meta}</span>}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="more">
      <a class="link link--sm" href={u('/writing#interviews')}>More interviews and talks</a>
    </p>
  </section>

  <section class="section enquiries" aria-labelledby="h-enquiries">
    <h2 class="label" id="h-enquiries">Enquiries</h2>
    <div>
      <p class="lede">
        Ben is represented by
        <a class="link" href={representation.agencyUrl} target="_blank" rel="noopener"
          >{representation.agent}</a
        > at <span class="nowrap">{representation.agency}</span>.
      </p>

      <!-- His university address, already public. Rights, press and speaking
           go through the agency; this is for everything else. -->
      <p class="enquiries__direct">
        Academic enquiries:
        <a class="link" href={`mailto:${representation.email}`}>{representation.email}</a>
      </p>
    </div>
  </section>
</Page>

<style>
  /* ------------------------------------------------------------------
     Frontispiece
  ------------------------------------------------------------------ */

  .frontis {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
    padding-block: var(--sp-xl) var(--sp-lg);
  }

  /* The photograph is already monochrome, so on white it needs nothing but a
     hair of contrast — the warmth it wanted on ivory would read as a cast. */
  .frontis__plate img {
    filter: contrast(1.03);
  }

  .title__name {
    font-size: clamp(3rem, 7vw, 5.5rem);
    letter-spacing: -0.015em;
  }

  /* Upright, at Ben's request: the roles are plain fact, and setting them in
     italic made them compete with the statement below, which is the line that
     should carry the voice. */
  .title__role {
    margin: var(--sp-sm) 0 0;
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: 1.45;
    color: var(--ink-60);
    /* Wide enough to keep "Philosophy and Art" together; balance stops the
       second line becoming a stub. */
    max-width: 46ch;
    text-wrap: balance;
  }

  .title__role:first-of-type {
    margin-top: var(--sp-md);
  }

  /* His own line, and the only italic in the block. No quotation marks and no
     attribution: it is not a citation here, it is him. */
  .title__quote {
    margin: var(--sp-lg) 0 0;
    max-width: 40ch;
  }

  .title__quote p {
    margin: 0;
    font-family: var(--display);
    font-style: italic;
    font-size: clamp(1.2rem, 1.8vw, 1.55rem);
    line-height: 1.45;
    color: var(--ink);
  }

  /* ------------------------------------------------------------------
     Books
  ------------------------------------------------------------------ */

  .lead {
    /* Sized so the jacket is the taller of the two columns: the row bottom is
       then the bottom of the book, and "Read more" lands exactly on it. The
       floor matters as much as the ceiling — a jacket that shrank with the
       viewport left the link hanging below it on middling screens. */
    --cover-h: clamp(15rem, 26vw, 19.5rem);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    /* Both columns fill the row, so the text column is exactly as tall as the
       jacket beside it. */
    align-items: stretch;
  }

  .lead__cover {
    display: block;
    /* Wide enough that the jacket fills its box at its own proportions rather
       than letterboxing inside it. */
    width: clamp(10rem, 17vw, 12.5rem);
  }

  /* A flex column whose last child is pushed to the foot: "Read more" then
     sits on the line the book stands on rather than floating halfway up it.
     The jacket is sized to be the taller of the two, so the row bottom and
     the bottom of the book are the same line. */
  .lead__text {
    display: flex;
    flex-direction: column;
    max-width: 46ch;
  }

  /* The dials took the place of the carousel's own head row, so the quote can
     sit closer under the title. */
  .lead__text :global(.carousel) {
    margin-top: var(--sp-sm);
  }

  .lead__text .more {
    margin-top: auto;
    padding-top: var(--sp-md);
  }

  /* flex-end puts the dials on the bottom line of the title block, which is
     the subtitle — so they read as sitting on the same line as "Beginning
     Again at the End" however many lines the title above it runs to. */
  .lead__titling {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--sp-md);
  }

  .lead__dots {
    flex: none;
    /* Nudged so the strokes land on the subtitle's baseline rather than on
       the bottom of its descenders. */
    margin-bottom: 0.28em;
  }

  .lead__title {
    margin: 0.6rem 0 0;
    font-size: clamp(1.5rem, 2.6vw, 2.15rem);
    line-height: 1.15;
  }

  .lead__sub {
    display: block;
    margin-top: 0.15em;
    font-size: 0.66em;
    color: var(--ink-70);
  }

  .lead__title a {
    transition: color var(--dur) var(--ease);
  }

  .lead__title a:hover {
    color: var(--accent);
  }

  /* The shelf: covers at a reading size, bottom-aligned on a shelf line and
     captioned beneath. auto-fit reflows it without a breakpoint. */
  .shelf {
    --cover-h: clamp(8rem, 13vw, 10.5rem);
    list-style: none;
    margin: var(--sp-xl) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8.5rem), 1fr));
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
    /* Each cover box is exactly --cover-h tall with the jacket sitting on its
       floor, so aligning the items to the TOP is what puts every jacket on the
       same shelf line — and it keeps the captions on one baseline even when
       they run to different numbers of lines. */
    align-items: start;
  }

  .shelf__title {
    display: block;
    margin-top: 0.65rem;
    font-family: var(--display);
    font-size: 1rem;
    line-height: 1.3;
    transition: color var(--dur) var(--ease);
  }

  .shelf__item:hover .shelf__title {
    color: var(--accent);
  }

  .shelf__meta {
    display: block;
    margin-top: 0.2rem;
    font-style: italic;
    font-size: 0.875rem;
    color: var(--ink-60);
  }

  /* ------------------------------------------------------------------
     Enquiries
  ------------------------------------------------------------------ */

  .enquiries {
    padding-top: var(--sp-2xl);
  }

  .enquiries__direct {
    margin: var(--sp-md) 0 0;
    color: var(--ink-60);
  }

  /* ------------------------------------------------------------------
     Narrow leaf: the plate leads, then the type.
  ------------------------------------------------------------------ */

  /* 38rem, not 51rem: the frontispiece is the page's whole argument — portrait
     facing the title, his eyeline running into the type — and it still fits
     comfortably at 600px. Collapsing it at 816px left the name and the lede in
     the left half of a tablet with the right half empty. */
  @media (max-width: 38rem) {
    .frontis {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-lg);
    }

    .frontis__plate {
      width: min(100%, 20rem);
    }
  }

  /* The lead book keeps the old breakpoint: its text block is a hook plus a
     rotating endorsement, which wants more room than the frontispiece does. */
  @media (max-width: 51rem) {
    .lead {
      grid-template-columns: minmax(0, 1fr);
    }

    /* The jacket is now sized by WIDTH, so the height has to stop being a
       number: --cover-h exists to make the jacket the taller of the two
       desktop columns, and any fixed value left here letterboxes the art
       inside a box the wrong shape — the column is often narrower than the
       9rem cap, so no single height can match it. auto lets the scan's own
       proportions decide, which is what sizing by width means. */
    .lead__cover {
      width: min(100%, 9rem);
      --cover-h: auto;
    }
  }
</style>
