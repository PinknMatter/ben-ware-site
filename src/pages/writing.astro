---
// Writing & Media.
//
// The essays are grouped under their year, with the year set large in the left
// margin — a spine down the page, so twelve pieces read as a body of work
// rather than as one long run of rows. Interviews and recorded talks follow in
// their own registers.
import Page from '../layouts/Page.astro';
import Flourish from '../components/Flourish.astro';
import { writing, interviews, videos, groupByYear } from '../data/writing.js';
import { u } from '../lib/url.js';

const years = groupByYear(writing);

const sections = [
  { id: 'essays', label: 'Essays & papers', count: writing.length },
  { id: 'interviews', label: 'Interviews', count: interviews.length },
  { id: 'talks', label: 'Talks & lectures', count: videos.length },
];
---

<Page
  title="Writing & Media — Ben Ware"
  socialTitle="Writing & Media"
  description="Essays, papers, interviews and recorded talks by Ben Ware — philosopher and social theorist."
>
  <div class="page-head">
    <h1 class="page-head__title">Writing</h1>
    <p class="lede">
      Essays and papers for <em>e-flux</em>, <em>Lit Hub</em>, <em>TANK</em>, the
      <em>Los Angeles Review of Books</em> and elsewhere, with interviews and recorded talks.
    </p>
  </div>

  <!-- A contents line, so the three registers are visible before you scroll. -->
  <nav class="jump" aria-label="Sections">
    <ul>
      {
        sections.map((s) => (
          <li>
            <a class="jump__link" href={`#${s.id}`}>
              {s.label}
              <span class="jump__count">{String(s.count).padStart(2, '0')}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <Flourish hand={0} />

  <!-- ------------------------------------------------------------------
       Essays and papers, on a year spine.
  ------------------------------------------------------------------- -->
  <section class="section" id="essays" aria-labelledby="h-essays">
    <h2 class="label" id="h-essays">Essays &amp; papers</h2>

    <div class="years">
      {
        years.map((group) => (
          <div class="year">
            <h3 class="year__no" aria-label={group.year === 'n.d.' ? 'No date' : group.year}>
              {group.year}
            </h3>
            <ul class="entries year__items">
              {group.items.map((item) =>
                item.url ? (
                  <li>
                    <a
                      class="entry entry--plain"
                      href={u(item.url)}
                      target="_blank"
                      rel="noopener"
                      data-todo={item.todo}
                    >
                      <span class="entry__text">
                        <span class="entry__title">{item.title}</span>
                        {item.venue && <span class="entry__meta">{item.venue}</span>}
                      </span>
                      <span class="tag">{item.pdf ? 'PDF' : item.form}</span>
                    </a>
                  </li>
                ) : (
                  <li>
                    {/* Nothing to link to yet — this reads as a catalogue entry
                        awaiting its reference, not as a dead link. */}
                    <span class="entry entry--plain entry--pending" data-todo={item.todo}>
                      <span class="entry__text">
                        <span class="entry__title">{item.title}</span>
                        <span class="entry__meta">Forthcoming</span>
                      </span>
                      <span class="tag">{item.form}</span>
                    </span>
                  </li>
                )
              )}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <Flourish hand={1} />

  <!-- ------------------------------------------------------------------
       Interviews — the interlocutor is the point, so it is set, not hidden
       in a parenthetical the way the source document had it.
  ------------------------------------------------------------------- -->
  <section class="section" id="interviews" aria-labelledby="h-interviews">
    <h2 class="label" id="h-interviews">Interviews</h2>
    <ul class="talks">
      {
        interviews.map((item) => (
          <li>
            <a class="talk" href={item.url} target="_blank" rel="noopener">
              <span class="talk__venue label">{item.venue}</span>
              <span class="talk__title">{item.title}</span>
              {item.with && <span class="talk__with">{item.with}</span>}
              <span class="talk__year tag" data-todo={item.todo}>
                {/* The source material carries no date for either interview. */}
                {item.year ?? 'Undated'}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <Flourish hand={2} />

  <section class="section" id="talks" aria-labelledby="h-talks">
    <h2 class="label" id="h-talks">Talks &amp; lectures</h2>
    <ul class="entries">
      {
        videos.map((item) => (
          <li>
            <a class="entry" href={item.url} target="_blank" rel="noopener">
              <span class="entry__year">{item.year}</span>
              <span class="entry__text">
                <span class="entry__title">{item.title}</span>
                {(item.venue || item.with) && (
                  <span class="entry__meta">{item.venue ?? item.with}</span>
                )}
              </span>
              <span class="tag">{item.form}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Page>

<style>
  /* ------------------------------------------------------------------
     Contents line
  ------------------------------------------------------------------ */

  .jump ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-md) clamp(1.5rem, 4vw, 3rem);
  }

  .jump__link {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-60);
    border-bottom: 1px solid var(--ink-18);
    padding-bottom: 3px;
    transition:
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .jump__link:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .jump__count {
    margin-left: 0.6em;
    color: var(--ink-25);
    font-variant-numeric: tabular-nums;
  }

  /* ------------------------------------------------------------------
     The year spine
  ------------------------------------------------------------------ */

  .years {
    display: flex;
    flex-direction: column;
    gap: var(--sp-lg);
  }

  .year {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: var(--sp-md);
    align-items: start;
  }

  /* Set large and pale: structure you read past, not a heading that competes
     with the titles beside it. */
  .year__no {
    font-family: var(--display);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1;
    color: var(--ink-25);
    font-variant-numeric: tabular-nums;
    padding-top: 0.9rem;
  }

  .year__items {
    border-top: 1px solid var(--ink-18);
  }

  @media (max-width: 40rem) {
    .year {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }

    .year__no {
      padding-top: 0;
      font-size: 1.25rem;
    }
  }

  /* ------------------------------------------------------------------
     Interviews — a different shape from the ruled rows, so the page does
     not read as three of the same table.
  ------------------------------------------------------------------ */

  .talks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .talk {
    display: block;
    padding: var(--sp-md) var(--sp-md) var(--sp-lg);
    border: 1px solid var(--ink-18);
    height: 100%;
    transition: border-color var(--dur) var(--ease);
  }

  .talk:hover {
    border-color: var(--ink-40);
  }

  .talk__venue {
    display: block;
  }

  .talk__title {
    display: block;
    margin-top: var(--sp-sm);
    font-family: var(--display);
    font-size: clamp(1.25rem, 2.2vw, 1.7rem);
    line-height: 1.2;
    transition: color var(--dur) var(--ease);
  }

  .talk:hover .talk__title {
    color: var(--accent);
  }

  .talk__with {
    display: block;
    margin-top: 0.5rem;
    font-style: italic;
    font-size: 0.9375rem;
    color: var(--ink-60);
  }

  .talk__year {
    display: block;
    margin-top: var(--sp-md);
  }
</style>
